---
// /kategorie/ — widok TYLKO mobile (design kategorie.html nie ma wariantu
// desktop). Na desktopie (≥1024px — breakpoint projektu) client-side
// redirect na /oferta/ PRZED paintem (inline skrypt w slocie head) +
// canonical wskazuje /oferta/ (brak duplicate content; analiza §7).
import BaseLayout from "@/layouts/BaseLayout.astro";
import Navbar from "@/components/navbar/Navbar.astro";
import Footer from "@/components/Footer.astro";
import { OFERTA_PATH } from "@/lib/routes";
---

<BaseLayout
  title="Kategorie oferty — Delung Meble"
  description="Pełna lista kategorii oferty Delung Meble — kuchnie, szafy i garderoby, wnętrza komercyjne, dekoracje okienne, zabudowy łazienkowe i meble nietypowe."
  canonicalPath={OFERTA_PATH}
  smoothScroll={false}
>
  <Fragment slot="head">
    <script is:inline>
      // Desktop nie ma tego widoku — natychmiastowy redirect na /oferta/
      // (location.replace: bez wpisu w historii). Breakpoint 1024px spójny
      // z designami; skrypt stoi na początku <head>, więc odpala przed
      // paintem — mobile nie płaci nic, desktop nie widzi mignięcia.
      if (matchMedia("(min-width:1024px)").matches)
        location.replace("/oferta/");
    </script>
  </Fragment>

  <Navbar />

  <main class="skel">
    <section class="skel-hero">
      <p class="kicker">Oferta</p>
      <h1>Kategorie</h1>
      <p class="lead">
        Pełna lista kategorii oferty (widok mobile) — powstaje w Etapie 4 razem
        z widokiem /oferta/.
      </p>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .skel {
    position: relative;
    z-index: 1;
    /* pasek jest sticky w flow — hero wypełnia resztę pierwszego ekranu */
    min-height: calc(100svh - var(--hdr-h, 74px));
    display: flex;
    flex-direction: column;
  }
  .skel-hero {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 1.2rem;
    padding: clamp(6rem, 18vh, 9rem) clamp(1.5rem, 6vw, 5rem) 4rem;
  }
  .kicker {
    margin: 0;
    font-family: var(--font-display), sans-serif;
    font-weight: 500;
    font-size: 11px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--accent-ink);
  }
  h1 {
    margin: 0;
    font-family: var(--font-display), sans-serif;
    font-weight: 200;
    font-size: clamp(2.2rem, 5.5vw, 4rem);
    line-height: 1.06;
    color: var(--ink);
  }
  .lead {
    margin: 0;
    max-width: 46ch;
    color: var(--muted);
    font-family: var(--font-body), sans-serif;
    line-height: 1.6;
  }
</style>
