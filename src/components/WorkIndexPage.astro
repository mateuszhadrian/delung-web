---
// Podstrona /realizacje/ (część 4.4) — port docs/design/realizacje.html;
// decyzje: docs/analiza-realizacje.md. Jasny design docelowy (koniec
// legacy-dark/Ambient z szablonu). Szyna filtrów: „Wszystkie" + tylko
// kategorie z wpisami (D-R1, workRail); filtrowanie i deep-link
// /realizacje/#<slug> (D-R2) w skrypcie niżej. Kafle otwierają detal
// w JEDNYM overlayu #work-detail (D-R3, open-detail.ts). Media w R2 —
// rozmiary wyłącznie przez imgAt() (w komponentach kafla/detalu).
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Navbar from "@/components/navbar/Navbar.astro";
import Footer from "@/components/Footer.astro";
import WorkIndexCard from "@/components/sections/work/WorkIndexCard.astro";
import WorkDetail from "@/components/sections/work/WorkDetail.astro";
import WorkDetailOverlay from "@/components/sections/work/WorkDetailOverlay.astro";
import { viewProject, workRail } from "@/components/sections/work/work-data";
import { CONTACT_PATH } from "@/lib/routes";
import { useTranslations } from "@/i18n/utils";

const t = useTranslations("pl");

// Pełna lista (strona główna kapuje do 3) — kolejność wg `order` z CMS.
const entries = await getCollection("realizacje");
const projects = entries
  .map((e) => e.data)
  .sort((a, b) => a.order - b.order)
  .map((p) => viewProject(p));

const rail = workRail(projects);
const pad = (n: number) => String(n).padStart(2, "0");
---

<BaseLayout title={t("workPage.title")} description={t("workPage.description")}>
  <script is:inline>
    // PRZED paintem: motion OK → html.js-motion (uzbraja stany startowe
    // revealów — reszta w work-motion.ts, ładowanym niżej).
    if (window.matchMedia("(prefers-reduced-motion: no-preference)").matches) {
      document.documentElement.classList.add("js-motion");
    }
  </script>

  <Navbar />

  <main class="re">
    <div class="re-in">
      <header class="re-head">
        <p class="re-kick" data-rev>REALIZACJE</p>
        <h1 data-rev>Nasze realizacje</h1>
        <div class="re-rule" aria-hidden="true"></div>
        <p class="re-lead" data-rev>
          <span class="re-leadLong"
            >Zobacz, jak zmieniamy puste wnętrza w przestrzeń dopasowaną do
            życia.
          </span>Każdy projekt to indywidualna historia, precyzja wykonania i
          materiały najwyższej jakości.<span class="re-leadLong">
            Zainspiruj się.</span
          >
        </p>
        <nav class="re-rail" data-rail aria-label="Filtry kategorii">
          {
            rail.map((item) => (
              <button
                type="button"
                data-f={item.slug ?? ""}
                class={item.slug === null ? "on" : undefined}
                aria-pressed={item.slug === null ? "true" : "false"}
              >
                <span>{item.label}</span>
                <b>{pad(item.count)}</b>
              </button>
            ))
          }
        </nav>
        {
          /* Telefon składany w JS (antyscraping D-CH5) — wypełnia
            fillContactSlots wołany przez Navbar; bez JS karta ukryta. */
        }
        <a class="re-phone" href={CONTACT_PATH} data-tel hidden>
          <b>SZUKASZ CZEGOŚ PODOBNEGO?</b>
          <span data-slot></span>
        </a>
      </header>

      <section class="re-list">
        {
          /* bez „NAJNOWSZE" + chevrona z makiety — sortowania nie ma
            (kolejność = `order` z CMS), atrapa selecta myliłaby */
        }
        <div class="re-bar">
          <span data-gridlabel
            >WSZYSTKIE KATEGORIE · {pad(projects.length)} Z {
              pad(projects.length)
            }</span
          >
        </div>
        <div class="re-grid" data-tiles>
          {projects.map((project) => <WorkIndexCard project={project} />)}
        </div>
      </section>
    </div>
  </main>

  <section class="re-cta">
    <div class="re-cta-in">
      <div class="re-cta-txt">
        <h2 data-rev>Masz pomysł na własne wnętrze?</h2>
        <p data-rev>
          Napisz lub zadzwoń — niezobowiązująca rozmowa i darmowy pomiar to
          pierwszy krok.
        </p>
      </div>
      <a href={CONTACT_PATH} data-rev="soft">
        <span>Skontaktuj się z nami</span>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M6 18L18 6M18 6H8M18 6v10"
            stroke="#fff"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>
  </section>

  <Footer />

  {/* Treść detalu per realizacja — klonowana do #work-detail po kliknięciu. */}
  {
    projects.map((project) => (
      <template data-work-detail={project.slug}>
        <WorkDetail project={project} />
      </template>
    ))
  }
  <WorkDetailOverlay />
</BaseLayout>

<script>
  // Filtry + deep-link #<slug> (D-R1/D-R2) i otwieranie detalu (D-R3).
  import {
    openWorkDetail,
    setDetailContext,
  } from "./sections/work/open-detail";
  import { WORK_DESKTOP_MIN_PX } from "./sections/work/work-config";

  const pad = (n: number) => String(n).padStart(2, "0");
  const tiles = Array.from(
    document.querySelectorAll<HTMLElement>("[data-tiles] [data-work-slug]"),
  );
  const buttons = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-rail] button"),
  );
  const label = document.querySelector<HTMLElement>("[data-gridlabel]");
  const total = tiles.length;
  const grid = document.querySelector<HTMLElement>("[data-tiles]");
  const rail = document.querySelector<HTMLElement>("[data-rail]");

  /** Powrót na początek listy po zmianie kategorii (D-T2).
   *  Skacze WYŁĄCZNIE w górę: kto filtruje stojąc na nagłówku strony, nie
   *  zostaje zepchnięty w dół — zgłoszenie dotyczy sytuacji odwrotnej
   *  (po zmianie filtra pierwszy kafel zostawał kilkaset pikseli nad
   *  ekranem, więc nie było widać wyniku filtrowania). */
  function scrollToListTop() {
    // celujemy w PIERWSZY WIDOCZNY KAFEL, nie w pudełko siatki: siatka ma
    // własny górny padding (kompensacja odstępów z D-Q4), przez który kafel
    // lądowałby niżej, niż wynika z przyklejonego chromu
    const kafel = tiles.find((t) => !t.hidden) ?? grid;
    if (!kafel) return;
    const hdr =
      parseFloat(
        getComputedStyle(document.documentElement).getPropertyValue("--hdr-h"),
      ) || 0;
    // Poniżej progu desktop szyna klei się NAD listą (D-Q4) i zasłoniłaby
    // pierwszy kafel; na desktopie jest częścią przyklejonej kolumny bocznej.
    const railH = matchMedia(`(min-width:${WORK_DESKTOP_MIN_PX}px)`).matches
      ? 0
      : (rail?.getBoundingClientRect().height ?? 0);
    const cel = Math.max(
      0,
      Math.round(
        kafel.getBoundingClientRect().top + window.scrollY - hdr - railH - 12,
      ),
    );
    if (window.scrollY <= cel) return;
    window.scrollTo({
      top: cel,
      behavior: matchMedia("(prefers-reduced-motion: no-preference)").matches
        ? "smooth"
        : "auto",
    });
  }

  /** Nakładka przywraca pozycję scrolla dopiero po przejściu zamknięcia
   *  (`unlockScroll` w overlay.ts), więc skok musi poczekać na jej koniec —
   *  inaczej przywrócona pozycja nadpisałaby nasz. */
  function afterDetailClosed(fn: () => void) {
    const el = document.getElementById("work-detail");
    if (!el || el.hidden) return fn();
    let done = false;
    const run = () => {
      if (done || !el.hidden) return;
      done = true;
      mo.disconnect();
      fn();
    };
    const mo = new MutationObserver(run);
    mo.observe(el, { attributes: true, attributeFilter: ["hidden"] });
    window.setTimeout(run, 600);
  }

  function applyFilter(slug: string, odUzytkownika = false) {
    let shown = 0;
    tiles.forEach((tile) => {
      const on = !slug || tile.dataset.cat === slug;
      tile.hidden = !on;
      if (on) shown += 1;
    });
    let name = "WSZYSTKIE KATEGORIE";
    buttons.forEach((b) => {
      const on = (b.dataset.f ?? "") === slug;
      b.classList.toggle("on", on);
      b.setAttribute("aria-pressed", String(on));
      if (on && slug)
        name = (b.querySelector("span")?.textContent ?? slug).toUpperCase();
    });
    if (label) label.textContent = `${name} · ${pad(shown)} Z ${pad(total)}`;
    // projnav/licznik detalu chodzą po AKTUALNIE przefiltrowanym zbiorze
    setDetailContext(
      tiles
        .filter((tile) => !tile.hidden)
        .map((tile) => ({
          slug: tile.dataset.workSlug ?? "",
          name: tile.dataset.workName ?? "",
        })),
    );
    // adres odzwierciedla filtr (deep-link D-R2) — bez wpisu w historii
    const hash = slug ? `#${slug}` : "";
    if (location.hash !== hash) {
      history.replaceState(null, "", hash || location.pathname);
    }
    // deep-link na wejściu NIE przewija (strona ma się pokazać od góry) —
    // stąd osobny argument zamiast bezwarunkowego skoku (D-T2)
    if (odUzytkownika) scrollToListTop();
  }

  const desktopMQ = matchMedia(`(min-width:${WORK_DESKTOP_MIN_PX}px)`);
  const motionOK = matchMedia("(prefers-reduced-motion: no-preference)");

  /** Przewija POZIOMĄ szynę (mobile) tak, by wybrana kategoria wypadła na
   *  środku ekranu; przy krańcach listy dojeżdża tylko do swojej krawędzi
   *  (clamp), więc po bokach nigdy nie powstaje pusty pas — wygląd paska
   *  zostaje bez zmian, ruszamy wyłącznie jego scrollem (runda 4).
   *  Na desktopie szyna jest pionową listą w przyklejonej kolumnie — nic
   *  nie robimy. Pionowy scroll strony to osobny mechanizm (D-T2). */
  function centerRailItem(btn: HTMLElement, smooth = true) {
    if (!rail || desktopMQ.matches) return;
    const max = rail.scrollWidth - rail.clientWidth;
    if (max <= 1) return; // wszystkie kategorie i tak widoczne
    const r = rail.getBoundingClientRect();
    const b = btn.getBoundingClientRect();
    const cel = Math.max(
      0,
      Math.min(
        max,
        Math.round(
          rail.scrollLeft + (b.left - r.left) - (r.width - b.width) / 2,
        ),
      ),
    );
    if (Math.abs(cel - rail.scrollLeft) < 1) return;
    rail.scrollTo({
      left: cel,
      behavior: smooth && motionOK.matches ? "smooth" : "auto",
    });
  }

  buttons.forEach((b) =>
    b.addEventListener("click", () => {
      applyFilter(b.dataset.f ?? "", true);
      centerRailItem(b);
    }),
  );

  // Deep-link na wejściu; slug spoza szyny (pusta kategoria, literówka)
  // → „Wszystkie".
  const initial = decodeURIComponent(location.hash.slice(1));
  applyFilter(buttons.some((b) => b.dataset.f === initial) ? initial : "");
  // wejście z deep-linkiem: pokaż wybraną kategorię od razu, ale BEZ ruchu
  // (animowany przejazd szyny przy pierwszym paincie wyglądałby na usterkę)
  const aktywny = buttons.find((b) => b.classList.contains("on"));
  if (aktywny) centerRailItem(aktywny, false);

  /** Kolumna nagłówka (desktop) jest przyklejona i rośnie z liczbą
   *  kategorii — przy komplecie wypychała kafel „SZUKASZ CZEGOŚ
   *  PODOBNEGO?" poza ekran (runda 4). Dwa stopnie ratunku: najpierw
   *  znika opis, potem zacieśniają się odstępy szyny. Liczy JS, bo CSS
   *  nie potrafi warunku „treść jest wyższa niż okno" — @media na
   *  wysokość nie wie, ile kategorii ma wpisy. */
  const head = document.querySelector<HTMLElement>(".re-head");
  function fitHeadColumn() {
    if (!head) return;
    head.classList.remove("is-tight", "is-tighter");
    if (!desktopMQ.matches) return;
    const hdr =
      parseFloat(
        getComputedStyle(document.documentElement).getPropertyValue("--hdr-h"),
      ) || 80;
    const dostepna = window.innerHeight - hdr;
    if (head.getBoundingClientRect().height <= dostepna) return;
    head.classList.add("is-tight"); // stopień 1: bez opisu
    if (head.getBoundingClientRect().height <= dostepna) return;
    head.classList.add("is-tighter"); // stopień 2: ciaśniejsza szyna
  }
  fitHeadColumn();
  let fitRaf = 0;
  addEventListener("resize", () => {
    cancelAnimationFrame(fitRaf);
    fitRaf = requestAnimationFrame(fitHeadColumn);
  });
  // wysokość paska zmienia się po podmianie fontu (--hdr-h) — kolumna
  // liczy się z niej, więc pomiar trzeba powtórzyć
  const hdrEl = document.querySelector(".hdr");
  if (hdrEl) new ResizeObserver(fitHeadColumn).observe(hdrEl);

  // Klik/tap w kafel → detal.
  document
    .querySelector<HTMLElement>("[data-tiles]")
    ?.addEventListener("click", (e) => {
      const card = (e.target as HTMLElement).closest<HTMLElement>(
        "[data-work-slug]",
      );
      if (!card?.dataset.workSlug) return;
      openWorkDetail(card.dataset.workSlug, card.dataset.workName ?? "");
    });

  // „Zobacz więcej z kategorii X" w detalu: na tej stronie = filtr +
  // zamknięcie (zachowanie eksportu); href #<slug> zostaje fallbackiem.
  document.addEventListener("click", (e) => {
    const more = (e.target as HTMLElement).closest<HTMLElement>(
      "[data-work-more-cat]",
    );
    if (!more) return;
    const slug = more.dataset.workMoreCat ?? "";
    if (!buttons.some((b) => b.dataset.f === slug)) return;
    e.preventDefault();
    applyFilter(slug);
    window.overlay?.close("work-detail");
    // skok dopiero po zamknięciu detalu — patrz afterDetailClosed
    afterDetailClosed(scrollToListTop);
  });

  // Ruch — dynamicznie, tylko przy motion OK (wzorzec D-SG9).
  if (matchMedia("(prefers-reduced-motion: no-preference)").matches) {
    import("./sections/work/work-motion");
  }
</script>

<style is:global>
  /* Odsłanianie treści przy przewijaniu — stan startowy WYŁĄCZNIE pod
     html.js-motion i tylko mobile (desktop eksportu miał osobne animacje
     GSAP, których nie portujemy — reguła sections.md; wzorzec 4.2/4.3). */
  @media (max-width: 1023px) {
    html.js-motion [data-rev] {
      opacity: 0;
      transform: translateY(22px);
      transition:
        opacity 0.7s ease,
        transform 0.8s cubic-bezier(0.22, 0.61, 0.36, 1);
    }
    html.js-motion [data-rev].rv-in {
      opacity: 1;
      transform: none;
    }
    html.js-motion [data-rev="soft"],
    html.js-motion [data-rev="soft"].rv-in {
      transform: none;
    }
  }
</style>

<style>
  /* ── Mobile (<1024): head + sticky szyna + siatka 1 kol. ── */
  .re {
    background: #fff;
  }
  .re-in {
    width: 100%;
    max-width: var(--col);
    margin-inline: auto;
  }
  /* display:contents — pudełko nagłówka znika z układu, więc blokiem
     zawierającym sticky szyny filtrów staje się `.re-in`, obejmujące CAŁĄ
     listę kafli (D-Q4; wcześniej szyna kleiła się przez ~20 px, bo tyle
     zostawało jej rodzicowi). Padding nagłówka rozchodzi się na sąsiadów
     co do piksela: 24 px w górę do `.re-kick`, 20 px w dół do `.re-grid`
     — układ się nie rusza, zmienia się wyłącznie zasięg przyklejenia.
     Desktop wraca do zwykłego bloku (tam nagłówek JEST sticky kolumną). */
  .re-head {
    display: contents;
  }
  .re-kick {
    padding-top: 24px;
    font-family: var(--font-display), sans-serif;
    font-weight: 500;
    font-size: clamp(10px, 2.82vw, 12px);
    line-height: 1;
    letter-spacing: 0.2em;
    color: var(--faint);
    margin-bottom: 14px;
    padding-inline: var(--pad);
  }
  .re-head h1 {
    font-family: var(--font-display), sans-serif;
    font-weight: 200;
    font-size: clamp(29px, 8.72vw, 38px);
    line-height: 1.12;
    padding-inline: var(--pad);
  }
  .re-rule {
    width: 44px;
    height: 1px;
    background: rgba(26, 26, 26, 0.3);
    margin: 16px var(--pad);
  }
  .re-lead {
    font-family: var(--font-display), sans-serif;
    font-weight: 200;
    font-size: clamp(13.5px, 3.97vw, 17px);
    line-height: 1.48;
    color: rgba(26, 26, 26, 0.78);
    text-wrap: pretty;
    padding-inline: var(--pad);
  }
  .re-leadLong {
    display: inline;
  }

  /* Szyna filtrów: sticky POD paskiem chrome'u (--hdr-h z navbara 4.1 —
     eksport przyklejał na top:0, gdzie chowała się pod sticky navbar;
     świadomy fix, D-R7). */
  .re-rail {
    display: flex;
    gap: 24px;
    overflow-x: auto;
    padding-block: 2px 0;
    padding-inline: var(--pad);
    scrollbar-width: none;
    border-bottom: 1px solid rgba(26, 26, 26, 0.12);
    position: sticky;
    top: var(--hdr-h, 74px);
    z-index: 3;
    background: #fff;
    margin-top: 18px;
    /* 20 px przejęte po dolnym paddingu `.re-head` (D-Q4) — celowo tutaj,
       a nie w `.re-grid`: zrzut wizualny siatki jest zrzutem ELEMENTU,
       więc jej własny padding wszedłby w kadr i ruszył baseline. */
    margin-bottom: 20px;
  }
  .re-rail::-webkit-scrollbar {
    display: none;
  }
  .re-rail button {
    appearance: none;
    border: none;
    background: none;
    margin: 0;
    cursor: pointer;
    flex: none;
    padding: 10px 2px 13px;
    font-family: var(--font-body), sans-serif;
    font-weight: 500;
    font-size: clamp(13px, 3.59vw, 15px);
    line-height: 1;
    white-space: nowrap;
    color: var(--faint);
    -webkit-tap-highlight-color: transparent;
    transition: color 0.3s ease;
  }
  .re-rail button.on {
    color: var(--ink);
    box-shadow: inset 0 -2px 0 0 #1a1a1a;
  }
  .re-rail button b {
    display: none;
  }
  .re-phone {
    display: none;
  }
  .re-bar {
    display: none;
  }

  /* ── Siatka kafli ── */
  .re-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    padding-block: 16px 44px;
    padding-inline: var(--pad);
  }

  /* ── CTA ── */
  .re-cta {
    background: #eae5dd;
    padding: 52px 0 56px;
    margin-top: 14px;
  }
  .re-cta-in {
    width: 100%;
    max-width: var(--col);
    margin-inline: auto;
    padding-inline: var(--pad);
  }
  .re-cta h2 {
    margin-bottom: 26px;
    font-family: var(--font-display), sans-serif;
    font-weight: 200;
    font-size: clamp(23px, 6.92vw, 30px);
    line-height: 1.22;
    text-wrap: pretty;
  }
  .re-cta-txt p {
    display: none;
  }
  .re-cta a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    background: var(--ink);
    color: #fff;
    border-radius: 999px;
    padding: 14px 28px;
    font-family: var(--font-body), sans-serif;
    font-weight: 500;
    font-size: clamp(14px, 4.36vw, 18px);
    line-height: 1;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
    text-decoration: none;
  }
  .re-cta a:hover {
    background: #2b2b2b;
  }
  .re-cta svg {
    width: 26px;
    height: 26px;
    flex: none;
    transition: transform 0.55s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .re-cta a:hover svg {
    transform: translate(5px, -5px);
  }

  /* ════ Desktop (≥1024): sticky kolumna z filtrami | lista ════ */
  @media (min-width: 1024px) {
    .re-in {
      display: flex;
      align-items: flex-start;
      gap: clamp(28px, 3.89vw, 56px);
      padding-inline: var(--pad);
    }
    .re-head {
      /* nagłówek wraca jako pudełko — na desktopie to ON jest sticky (D-Q4) */
      display: block;
      position: sticky;
      top: var(--hdr-h, 80px);
      width: clamp(220px, 20vw, 288px);
      flex: none;
      padding: clamp(34px, 3.33vw, 48px) 0 40px;
      align-self: flex-start;
    }
    .re-kick,
    .re-head h1,
    .re-lead {
      padding-inline: 0;
    }
    .re-kick {
      /* padding-top nosi mobilny nagłówek bez pudełka (D-Q4) — tu zbędny */
      padding-top: 0;
      font-size: clamp(10.5px, 0.83vw, 12px);
      letter-spacing: 0.22em;
      color: var(--accent-ink);
      margin-bottom: 16px;
    }
    .re-head h1 {
      font-size: clamp(32px, 2.92vw, 42px);
      line-height: 1.08;
    }
    .re-rule {
      display: none;
    }
    .re-lead {
      margin: 20px 0 32px;
      font-size: clamp(14px, 1.08vw, 15.5px);
      line-height: 1.6;
      color: rgba(26, 26, 26, 0.7);
    }
    .re-leadLong {
      display: none;
    }
    .re-rail {
      display: block;
      position: static;
      border-bottom: none;
      border-top: 1px solid rgba(26, 26, 26, 0.14);
      padding: 0;
      margin: 0;
      overflow: visible;
      background: none;
    }
    /* Dwa stopnie ratunku, gdy przyklejona kolumna nie mieści się w oknie
       (klasy zakłada fitHeadColumn w skrypcie strony — runda 4). Stopień 1
