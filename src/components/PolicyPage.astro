---
// Polityka prywatności (/polityka-prywatnosci/) — treść lokalnie w tym
// pliku (nie w i18n/ui.ts): to dokument prawny, nie tekst interfejsu;
// jeden plik = łatwy przegląd i wycofanie. Treść 1:1 z docs/design/
// polityka-prywatnosci.html (9 sekcji, dane administratora z designu —
// decyzja D4); znaczniki „[do uzupełnienia]" designu wypełnione realnym
// stackiem (Cloudflare/Resend/OVH — sekcje 04–05 wg faktycznej
// architektury).
// Layout = port markupu pp-* designu (część 4.5, D-P8): head na cream,
// dokument z desktopowym sticky TOC (kotwice #pp-NN), pasek CTA.
// E-mail i telefon administratora składane w JS przez WSPÓLNY mechanizm
// chrome'u (lib/contact-details — sloty [data-mail]/[data-tel], wypełnia
// fillContactSlots z navbara; D-CH5) — pełne ciągi nie mogą wystąpić
// w dist (kontrakt antyscrapingowy w tests/e2e/contact.spec.ts);
// fallback bez JS wskazuje formularz kontaktowy.
import BaseLayout from "@/layouts/BaseLayout.astro";
import Navbar from "@/components/navbar/Navbar.astro";
import Footer from "@/components/Footer.astro";
import { CONTACT_PATH } from "@/lib/routes";

type Section = {
  h: string;
  pre?: string[];
  list?: string[];
  post?: string[];
};

const MAIL_SLOT = `<a data-mail hidden href="${CONTACT_PATH}"></a>`;
const TEL_SLOT = `<a data-tel hidden href="${CONTACT_PATH}"></a>`;

const c = {
  title: "Polityka prywatności — Delung Meble",
  description:
    "Zasady przetwarzania danych osobowych przekazanych przez formularz kontaktowy na delung.pl — prostym językiem, zgodnie z RODO.",
  eyebrow: "OCHRONA DANYCH OSOBOWYCH",
  heading: "Polityka prywatności",
  effective: "OBOWIĄZUJE OD 11 LIPCA 2026 R.",
  intro:
    "Ta polityka opisuje, jak przetwarzamy dane osobowe przekazane przez formularz kontaktowy na stronie delung.pl. Piszemy prostym językiem — bez prawniczego szumu, ale z kompletem informacji wymaganych przez RODO.",
  tocHead: "W TYM DOKUMENCIE",
  tocAsk: "Masz pytanie o dane? Napisz",
  ctaKick: "MASZ PYTANIA O SWOJE DANE?",
  ctaH: "Napisz albo po prostu zadzwoń.",
  ctaP: "W tygodniu jesteśmy pod telefonem praktycznie całą dobę.",
  ctaBack: "Wróć do kontaktu",
  sections: [
    {
      h: "Administrator danych",
      pre: [
        "Administratorem Twoich danych osobowych jest <strong>Adam Delung</strong>, prowadzący działalność gospodarczą pod firmą Delung Meble Adam Delung, Strażacka 27a, 98-300 Gaszyn, NIP: 7312021984 — operator strony delung.pl.",
        `W sprawach dotyczących danych osobowych napisz na adres ${MAIL_SLOT}, zadzwoń pod ${TEL_SLOT} albo skorzystaj z <a href="${CONTACT_PATH}">formularza kontaktowego</a>.`,
      ],
    },
    {
      h: "Jakie dane przetwarzamy",
      pre: [
        "Z formularza kontaktowego: imię i nazwisko, numer telefonu, adres e-mail oraz treść wiadomości.",
        "Automatycznie, w warstwie technicznej: adres IP i podstawowe informacje o przeglądarce — wykorzystywane przez infrastrukturę Cloudflare (hosting, zapora WAF, mechanizm antybotowy Turnstile) wyłącznie do ochrony strony przed spamem i nadużyciami.",
        "Strona nie prowadzi analityki, nie wyświetla reklam i nie używa plików cookie do celów marketingowych.",
      ],
    },
    {
      h: "Cel i podstawa prawna",
      list: [
        "<strong>Odpowiedź na Twoją wiadomość i dalsza korespondencja</strong> — art. 6 ust. 1 lit. f RODO (prawnie uzasadniony interes: komunikacja z osobą, która kieruje do nas zapytanie), a gdy wiadomość dotyczy wyceny lub realizacji mebli — art. 6 ust. 1 lit. b RODO (działania podjęte na Twoje żądanie przed zawarciem umowy).",
        "<strong>Ochrona strony przed spamem, botami i nadużyciami</strong> — art. 6 ust. 1 lit. f RODO (prawnie uzasadniony interes: bezpieczeństwo usługi).",
      ],
    },
    {
      h: "Odbiorcy danych",
      pre: [
        "Korzystamy z usług podmiotów przetwarzających, które obsługują techniczną stronę komunikacji:",
      ],
      list: [
        "<strong>Cloudflare</strong> — hosting strony, zapora sieciowa i ochrona antybotowa (Turnstile),",
        "<strong>Resend</strong> (resend.com) — wysyłka wiadomości e-mail z formularza (powiadomienie do nas i automatyczne potwierdzenie do Ciebie); infrastruktura wysyłkowa w regionie UE (Irlandia),",
        "<strong>OVH</strong> — skrzynka pocztowa, do której trafia i w której jest przechowywana korespondencja.",
      ],
      post: [
        "Twoje dane nie są sprzedawane ani udostępniane nikomu do jego własnych celów (np. marketingowych).",
      ],
    },
    {
      h: "Przekazywanie danych poza EOG",
      pre: [
        "Resend i Cloudflare mają siedziby w USA, więc część danych może być przetwarzana poza Europejskim Obszarem Gospodarczym. Podstawą takiego transferu są standardowe klauzule umowne zatwierdzone przez Komisję Europejską (art. 46 ust. 2 lit. c RODO) oraz — w zakresie, w jakim dostawca posiada aktualną certyfikację — program EU-U.S. Data Privacy Framework. Skrzynka pocztowa (OVH) znajduje się w EOG.",
      ],
    },
    {
      h: "Jak długo przechowujemy dane",
      pre: [
        "Formularz niczego nie zapisuje po drodze — wiadomość trafia bezpośrednio na naszą skrzynkę e-mail. Korespondencję przechowujemy tak długo, jak wymaga tego obsługa sprawy, a w razie nawiązania współpracy — przez okres przedawnienia ewentualnych roszczeń. Krótkotrwałe logi techniczne u dostawców (np. logi wysyłki) są usuwane automatycznie zgodnie z ich politykami retencji.",
      ],
    },
    {
      h: "Twoje prawa",
      pre: ["W związku z przetwarzaniem danych masz prawo do:"],
      list: [
        "dostępu do swoich danych i otrzymania ich kopii,",
        "sprostowania danych,",
        "usunięcia danych,",
        "ograniczenia przetwarzania,",
        "sprzeciwu wobec przetwarzania opartego na prawnie uzasadnionym interesie,",
        "przenoszenia danych.",
      ],
      post: [
        'Żeby skorzystać z tych praw, po prostu napisz lub zadzwoń — dane kontaktowe w punkcie 01. Masz też prawo wnieść skargę do Prezesa Urzędu Ochrony Danych Osobowych (<a href="https://uodo.gov.pl" target="_blank" rel="noopener noreferrer">uodo.gov.pl</a>).',
      ],
    },
    {
      h: "Dobrowolność i decyzje automatyczne",
      pre: [
        "Podanie danych jest dobrowolne, ale bez numeru telefonu lub adresu e-mail nie będziemy w stanie odpowiedzieć. Nie podejmujemy decyzji w sposób zautomatyzowany i nie profilujemy użytkowników — mechanizm antybotowy (Cloudflare Turnstile) ocenia wyłącznie, czy formularz wysyła człowiek.",
      ],
    },
    {
      h: "Zmiany tej polityki",
      pre: [
        "Aktualna wersja polityki jest zawsze dostępna pod tym adresem. Istotne zmiany będą odnotowane nową datą obowiązywania.",
      ],
    },
  ] satisfies Section[],
} as const;

const pad = (n: number) => String(n + 1).padStart(2, "0");
---

<BaseLayout title={c.title} description={c.description} smoothScroll="desktop">
  <Navbar />

  <main>
    <section class="pp-head">
      <div class="pp-head-in">
        <p class="pp-kick">{c.eyebrow}</p>
        <h1>{c.heading}</h1>
        <div class="pp-rule" aria-hidden="true"></div>
        <p class="pp-date">{c.effective}</p>
        <p class="pp-lead">{c.intro}</p>
      </div>
    </section>

    <div class="pp-doc">
      <aside class="pp-toc">
        <p class="pp-toc-h">{c.tocHead}</p>
        <nav class="pp-toc-list" aria-label="Spis treści polityki">
          {
            c.sections.map((s, i) => (
              <a href={`#pp-${pad(i)}`}>
                <span aria-hidden="true" data-n={pad(i)} />
                {s.h}
              </a>
            ))
          }
        </nav>
        <a class="pp-toc-ask" href={CONTACT_PATH}>
          {c.tocAsk}
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="M6 18L18 6M18 6H8M18 6v10"
              stroke="#1a1a1a"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
      </aside>

      <div class="pp-secs">
        {
          c.sections.map((s, i) => (
            <section class="pp-sec" id={`pp-${pad(i)}`}>
              {/* numer przez content:attr() — dekoracja .4 poza zasięgiem
                  color-contrast axe (wzorzec numeru-ducha procesu) */}
              <span class="pp-num" aria-hidden="true" data-n={pad(i)} />
              <div class="pp-body">
                <h2>{s.h}</h2>
                {s.pre?.map((p) => (
                  <p set:html={p} />
                ))}
                {s.list && (
                  <ul>
                    {s.list.map((li) => (
                      <li set:html={li} />
                    ))}
                  </ul>
                )}
                {s.post?.map((p) => (
                  <p set:html={p} />
                ))}
              </div>
            </section>
          ))
        }
      </div>
    </div>

    <section class="pp-cta">
      <div class="pp-cta-in">
        <div class="pp-cta-txt">
          <p class="pp-kick">{c.ctaKick}</p>
          <h2>{c.ctaH}</h2>
          <p>{c.ctaP}</p>
        </div>
        <div class="pp-cta-btns">
          <a class="pp-tel" data-tel hidden href={CONTACT_PATH}>Telefon</a>
          <a class="pp-back" href={CONTACT_PATH}>
            <span>{c.ctaBack}</span>
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path
                d="M6 18L18 6M18 6H8M18 6v10"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  /* ── pasek tytułowy ── */
  .pp-head {
    background: var(--bg-cream);
    padding: 24px 0 30px;
  }
  .pp-head-in {
    width: 100%;
    max-width: var(--col);
    margin-inline: auto;
    padding-inline: var(--pad);
  }
  .pp-kick {
    font-family: var(--font-display), sans-serif;
    font-weight: 500;
    font-size: clamp(10px, 2.82vw, 12px);
    line-height: 1;
    letter-spacing: 0.2em;
    /* eksport .5 — podbite do --faint (ratchet axe) */
    color: var(--faint);
    margin-bottom: 14px;
  }
  h1 {
    font-family: var(--font-display), sans-serif;
    font-weight: 200;
    font-size: clamp(29px, 8.72vw, 38px);
    line-height: 1.12;
    color: var(--ink);
  }
  .pp-rule {
    width: 44px;
    height: 1px;
    background: rgba(26, 26, 26, 0.3);
    margin: 16px 0;
  }
  .pp-date {
    margin-bottom: 14px;
    font-family: var(--font-display), sans-serif;
    font-weight: 500;
    font-size: 11px;
    line-height: 1.5;
    letter-spacing: 0.14em;
    /* eksport .45 — podbite do --faint (ratchet axe) */
    color: var(--faint);
  }
  .pp-lead {
    font-family: var(--font-display), sans-serif;
    font-weight: 200;
    font-size: clamp(13.5px, 3.97vw, 17px);
    line-height: 1.48;
    color: var(--muted);
    text-wrap: pretty;
  }

  /* ── dokument ── */
  .pp-doc {
    width: 100%;
    max-width: var(--col);
    margin-inline: auto;
    padding-block: 0 40px;
    padding-inline: var(--pad);
    display: flex;
    flex-direction: column;
  }
  .pp-toc {
    display: none;
  }
  .pp-secs {
    display: flex;
    flex-direction: column;
  }
  .pp-sec {
    padding: 26px 0 30px;
    border-top: 1px solid rgba(26, 26, 26, 0.14);
    /* kotwice TOC lądują pod sticky paskiem (eksport 100px — pod --hdr-h,
       dewiacja-fix D-P9) */
    scroll-margin-top: calc(var(--hdr-h, 74px) + 26px);
  }
  .pp-num {
    display: block;
    font-family: var(--font-mono), monospace;
    font-weight: 500;
    font-size: 11px;
    line-height: 1;
    color: rgba(26, 26, 26, 0.4);
    margin-bottom: 10px;
  }
  .pp-num::before {
    content: attr(data-n);
  }
  .pp-body h2 {
    margin-bottom: 12px;
    font-family: var(--font-display), sans-serif;
    font-weight: 200;
    font-size: clamp(19px, 5.64vw, 24px);
    line-height: 1.27;
    color: var(--ink);
  }
  .pp-body p,
  .pp-body li {
    font-family: var(--font-display), sans-serif;
    font-weight: 200;
    font-size: clamp(13px, 3.72vw, 15.5px);
    line-height: 1.52;
    color: var(--muted);
    text-wrap: pretty;
  }
  .pp-body p + p {
    margin-top: 12px;
  }
  .pp-body h2 + p {
    margin-top: 0;
  }
  /* lista z pauzami designu (.pp-bs/.pp-b) na semantycznym <ul> */
  .pp-body ul {
    list-style: none;
    margin: 12px 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .pp-body li {
    display: flex;
    gap: 10px;
  }
  .pp-body li::before {
    content: "—";
    flex: none;
    color: rgba(26, 26, 26, 0.35);
  }
  /* Treść sekcji renderowana przez set:html + sloty tel/mail wypełniane
     w JS — elementy bez atrybutu scope Astro, stąd :global. */
  .pp-body :global(strong) {
    color: var(--ink);
    font-weight: 500;
  }
  .pp-body :global(a) {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .pp-body :global(a:hover),
  .pp-body :global(a:focus-visible) {
    opacity: 0.65;
  }
  .pp-body :global(a[hidden]) {
    display: none;
  }

  /* ── pasek CTA ── */
  .pp-cta {
    background: #eae5dd;
    padding: 34px 0 38px;
  }
  .pp-cta-in {
    width: 100%;
    max-width: var(--col);
    margin-inline: auto;
    padding-inline: var(--pad);
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .pp-cta-txt {
    display: none;
  }
  .pp-cta-btns {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .pp-cta-btns a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    border-radius: 999px;
    padding: 14px 28px;
    font-family: var(--font-body), sans-serif;
    font-weight: 500;
    font-size: clamp(14px, 4.1vw, 17px);
    line-height: 1;
    text-decoration: none;
  }
  .pp-cta-btns svg {
    width: 24px;
    height: 24px;
    flex: none;
  }
  .pp-back {
    background: var(--ink);
    color: #fff;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
  }
  .pp-back:hover {
    background: #2b2b2b;
  }
  .pp-tel {
    display: none;
  }

  /* ════ DESKTOP ≥1024 (breakpoint projektu — @media bez stałej:
     widok bez logiki JS zależnej od progu) ════ */
  @media (min-width: 1024px) {
    .pp-head {
      padding: clamp(56px, 5.42vw, 78px) 0 clamp(52px, 5.14vw, 74px);
    }
    .pp-head-in {
      max-width: 1180px;
      margin-inline: 0;
    }
    .pp-kick {
      font-size: clamp(10px, 0.76vw, 11px);
      letter-spacing: 0.22em;
      margin-bottom: 22px;
    }
    h1 {
      font-size: clamp(50px, 5vw, 72px);
      line-height: 1.06;
    }
    .pp-rule {
      margin: 30px 0 22px;
    }
    .pp-date {
      font-size: 11px;
      letter-spacing: 0.16em;
      margin-bottom: 18px;
    }
    .pp-lead {
      max-width: 74ch;
      font-size: clamp(16px, 1.25vw, 18px);
      line-height: 1.7;
    }

    .pp-doc {
      display: grid;
      grid-template-columns: clamp(220px, 20.8vw, 300px) 1fr;
      gap: clamp(40px, 5.56vw, 80px);
      align-items: start;
      padding-block: clamp(50px, 4.86vw, 70px) clamp(64px, 6.25vw, 90px);
    }
    .pp-toc {
      display: flex;
      position: sticky;
      /* eksport clamp(96…120) liczone bez naszego paska — pod --hdr-h */
      top: calc(var(--hdr-h, 74px) + 24px);
      flex-direction: column;
      gap: 14px;
    }
    .pp-toc-h {
      font-family: var(--font-display), sans-serif;
      font-weight: 500;
      font-size: 10.5px;
      line-height: 1;
      letter-spacing: 0.2em;
      /* eksport .45 — podbite do --faint (ratchet axe) */
      color: var(--faint);
    }
    .pp-toc-list {
      display: flex;
      flex-direction: column;
      gap: 11px;
      padding-top: 6px;
      border-top: 1px solid rgba(26, 26, 26, 0.14);
    }
    .pp-toc-list a {
      display: flex;
      gap: 12px;
      font-family: var(--font-display), sans-serif;
      font-weight: 300;
      font-size: clamp(13px, 1.01vw, 14.5px);
      line-height: 1.5;
      color: var(--ink);
      text-decoration: none;
      position: relative;
    }
    .pp-toc-list a span {
      flex: none;
      font-family: var(--font-mono), monospace;
      font-weight: 500;
      font-size: 11px;
      line-height: 1.6;
      color: rgba(26, 26, 26, 0.35);
    }
    .pp-toc-list a span::before {
      content: attr(data-n);
    }
    .pp-toc-list a:hover {
      color: var(--accent-ink);
    }
    .pp-toc-ask {
      margin-top: 16px;
      display: inline-flex;
      align-items: center;
      gap: 10px;
      font-family: var(--font-display), sans-serif;
      font-weight: 300;
      font-size: clamp(13px, 1.01vw, 14.5px);
      color: var(--ink);
      text-decoration: none;
    }
    .pp-toc-ask:hover {
      opacity: 0.6;
    }
    .pp-toc-ask svg {
      width: 17px;
      height: 17px;
      flex: none;
    }

    .pp-secs {
      max-width: 840px;
    }
    .pp-sec {
      display: grid;
      grid-template-columns: 64px 1fr;
      gap: 24px;
      padding: clamp(32px, 3.06vw, 44px) 0;
      scroll-margin-top: calc(var(--hdr-h, 74px) + 28px);
    }
    .pp-sec:first-child {
      padding-top: 0;
      border-top: none;
    }
    .pp-sec:last-child {
      padding-bottom: 0;
    }
    .pp-num {
      font-size: 12px;
      line-height: 1.6;
      padding-top: 9px;
      margin-bottom: 0;
    }
    .pp-body h2 {
      margin-bottom: 18px;
      font-size: clamp(24px, 2.22vw, 32px);
      line-height: 1.2;
    }
    .pp-body p,
    .pp-body li {
      font-size: clamp(15px, 1.15vw, 16.5px);
      line-height: 1.75;
    }
    .pp-body p + p {
      margin-top: 16px;
    }
    .pp-body :global(a) {
      text-underline-offset: 3px;
    }
    .pp-body ul {
      gap: 14px;
      margin: 16px 0;
    }
    .pp-body li {
      gap: 14px;
    }

    .pp-cta {
      padding: clamp(44px, 4.17vw, 60px) 0;
    }
    .pp-cta-in {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: clamp(30px, 3.47vw, 50px);
    }
    .pp-cta-txt {
      display: block;
    }
    .pp-cta-txt h2 {
      font-family: var(--font-display), sans-serif;
      font-weight: 200;
      font-size: clamp(28px, 2.64vw, 38px);
      line-height: 1.15;
      color: var(--ink);
    }
    .pp-cta-txt p {
      margin-top: 12px;
      font-family: var(--font-display), sans-serif;
      font-weight: 200;
      font-size: clamp(14px, 1.11vw, 16px);
      line-height: 1.65;
      color: var(--muted);
    }
    .pp-cta-txt .pp-kick {
      margin-bottom: 14px;
    }
    .pp-cta-btns {
      flex: none;
      flex-direction: row;
      gap: 14px;
    }
    .pp-cta-btns a {
      justify-content: center;
      padding: clamp(15px, 1.32vw, 19px) clamp(24px, 2.36vw, 34px);
      font-size: clamp(15px, 1.18vw, 17px);
      box-shadow: none;
    }
    .pp-cta-btns svg {
      width: 18px;
      height: 18px;
    }
    .pp-tel {
      display: flex;
      background: var(--ink);
      color: #fff;
    }
    .pp-tel:hover {
      background: #2b2b2b;
    }
