---
// Widok /kontakt/ (Etap 5) — port docs/design/kontakt.html; decyzje:
// docs/analiza-kontakt.md. Navbar `over` w tonie JASNYM (eksport kontaktu
// nie ma bloku .hdr.dark — po scrollu wjeżdża białe tło).
// Kolejność w DOM: hero → kafle → social (mobile) → formularz → social
// (desktop). Eksport przestawia sekcje CSS-owym `order`; my renderujemy
// duplikat pigułki social per breakpoint (D-K3), żeby kolejność tabulacji
// zgadzała się z wizualną na obu progach.
// Scroll NATYWNY (smoothScroll={false}, D-K9): formularz najlepiej czuje
// się bez pośrednika (fokus pól, dojazd do błędnego pola, klawiatura
// ekranowa), a widok jest krótki — Lenis nie ma tu czego wygładzać.
import BaseLayout from "@/layouts/BaseLayout.astro";
import Navbar from "@/components/navbar/Navbar.astro";
import Footer from "@/components/Footer.astro";
import ContactHero from "@/components/sections/contact/ContactHero.astro";
import ContactCards from "@/components/sections/contact/ContactCards.astro";
import ContactSoc from "@/components/sections/contact/ContactSoc.astro";
import ContactForm from "@/components/sections/contact/ContactForm.astro";
import { useTranslations } from "@/i18n/utils";

const t = useTranslations("pl");
---

<BaseLayout
  title={t("contactPage.title")}
  description={t("contactPage.description")}
  smoothScroll={false}
>
  <script is:inline>
    // PRZED paintem: motion OK → html.js-motion (uzbraja stany startowe
    // revealów — reszta w contact-motion.ts, ładowanym niżej).
    if (window.matchMedia("(prefers-reduced-motion: no-preference)").matches) {
      document.documentElement.classList.add("js-motion");
    }
  </script>

  <Navbar variant="over" />

  <main>
    <ContactHero />
    <ContactCards />
    <ContactSoc at="mobile" />
    <ContactForm />
    <ContactSoc at="desktop" />
  </main>

  <Footer />
</BaseLayout>

<style is:global>
  /* Odsłanianie treści przy przewijaniu — tylko widok mobilny; stan
     startowy WYŁĄCZNIE pod html.js-motion (bez JS / przy reduce treść
     od razu widoczna — reguła sections.md; wzorzec ProcesPage 4.5). */
  @media (max-width: 1023px) {
    html.js-motion [data-rev] {
      opacity: 0;
      transform: translateY(22px);
      transition:
        opacity 0.7s ease,
        transform 0.8s cubic-bezier(0.22, 0.61, 0.36, 1);
    }
    html.js-motion [data-rev].rv-in {
      opacity: 1;
      transform: none;
    }
  }

  /* Dojazd kotwicą/fokusem pod sticky paskiem: sekcja i pola nie chowają
     się pod navbarem (--hdr-h ustawia skrypt chrome'u — wzorzec D-P9/D-R7). */
  #contact {
    scroll-margin-top: calc(var(--hdr-h, 72px) + 8px);
  }
  #contact .kt-field {
    scroll-margin-top: calc(var(--hdr-h, 72px) + 16px);
  }
</style>

<script>
  import { initContactUi } from "@/components/sections/contact/contact-ui";

  // Formularz działa ZAWSZE (to funkcja, nie dekoracja); choreografia
  // wejść tylko przy dozwolonym ruchu — ta sama bramka co w 4.2–4.5.
  const section = document.querySelector<HTMLElement>("#contact");
  if (section) initContactUi(section);

  if (matchMedia("(prefers-reduced-motion: no-preference)").matches) {
    import("@/components/sections/contact/contact-motion");
  }
</script>
