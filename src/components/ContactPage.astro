---
// Podstrona „Kontakt" (PL: /kontakt/, EN: /en/contact/) — sekcja Contact
// z formularzem przeniesiona W CAŁOŚCI ze strony głównej (tam został banner
// KontaktBaner.astro); plan: docs/analiza-podstrona-kontakt.md. Chrome
// globalny (Navbar + Footer — część 4.1), jedna statyczna warstwa ambientu
// (RED, jak tło sekcji na głównej), scroll NATYWNY (smoothScroll={false}, jak
// /realizacje/) — sekcja nie ma pinowanych scen, a formularz najlepiej
// czuje się bez pośrednika (fokus pól, autoscroll do błędów walidacji).
import "@/styles/legacy-dark.css";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Navbar from "@/components/navbar/Navbar.astro";
import AmbientBackground from "@/components/backgrounds/AmbientBackground.astro";
import Contact from "@/components/sections/contact/Contact.astro";
import Footer from "@/components/Footer.astro";
import { useTranslations } from "@/i18n/utils";

const t = useTranslations("pl");
---

<BaseLayout
  title={t("contactPage.title")}
  description={t("contactPage.description")}
  smoothScroll={false}
>
  <div class="ktp-bg" aria-hidden="true">
    <AmbientBackground variant="red" />
  </div>

  <Navbar />

  <main class="ktp">
    <Contact lang="pl" />
  </main>

  {/* Współdzielony footer strony (ten sam co finał strony głównej). */}
  <div class="ktp-foot">
    <Footer />
  </div>
</BaseLayout>

<style>
  :global(body) {
    background: #000;
  }

  /* Jedna statyczna warstwa ambientu — bez crossfade'u strony głównej
     (podczas jazdy przez sekcję na głównej tłem był wariant red). */
  .ktp-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    background: #000;
    pointer-events: none;
  }

  .ktp {
    position: relative;
    z-index: 1;
  }

  /* ── Stopka: full-bleed (Footer.astro sam kontroluje kontener/wrap);
     z-index tylko wynosi ją nad warstwę ambientu. ── */
  .ktp-foot {
    position: relative;
    z-index: 1;
  }
</style>
