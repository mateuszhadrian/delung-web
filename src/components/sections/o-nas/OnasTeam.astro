---
// Zespół (eksport: .team z o-nas.html). Mobile (<1024, jasny): van nad
// kickerem, intro (z dopiskiem „Kto za tym stoi?"), Adam duży + cytat
// z dopiskiem, Tomek i Marcin w siatce 2 kolumn. Desktop (≥1024, ciemny):
// sekcja przypięta 300vh — head (kicker/h2 + licznik 01/03) i poziomy tor
// 3 kart przesuwany postępem scrolla (onas-motion). Wysokość/sticky toru
// uzbraja html.js-motion (wzorzec scen 4.2) — bez JS / przy reduce tor
// jest zwykłym overflow-x: auto. Obie gałęzie w SSR (D-P3), te same
// pliki portretów = jeden fetch.
import { INTRO_TEXT, ZESPOL } from "./onas-content";
import { TEAM_IMAGES } from "./onas-images";
import fiatImg from "@/assets/o-nas/fiat-bus.webp";

const [ADAM, ...RESZTA] = ZESPOL;
const ADAM_IMG = TEAM_IMAGES[ADAM.name];
---

<section class="team">
  <div class="team-in">
    <div class="team-head">
      <div class="team-headL">
        <div class="team-van" aria-hidden="true">
          <img
            src={fiatImg.src}
            width={fiatImg.width}
            height={fiatImg.height}
            alt=""
            loading="lazy"
            decoding="async"
          />
        </div>
        <p class="team-kick" data-rev>LUDZIE I PASJA</p>
        <h2 data-rev>Zgrana ekipa od zadań specjalnych.</h2>
        <div class="team-rule" aria-hidden="true"></div>
        <p class="team-intro" data-rev>
          {INTRO_TEXT}<span class="team-intro-m"> Kto za tym stoi?</span>
        </p>
      </div>
      {
        /* mianownik „/ 03" przez content: (pseudo-element nie jest text
           node'em — dekoracja .4 poza zasięgiem color-contrast axe;
           wzorzec numeru-ducha kroków procesu) */
      }
      <div class="team-count" aria-hidden="true">
        <b data-teamcount>01</b><i></i>
      </div>
    </div>

    {/* desktop: przypięty tor kart */}
    <div class="team-hold">
      <div class="team-desk" data-teamtrack>
        {
          ZESPOL.map((t) => (
            <div class="tc">
              <div class="tc-img">
                <img
                  src={TEAM_IMAGES[t.name].src}
                  width={TEAM_IMAGES[t.name].width}
                  height={TEAM_IMAGES[t.name].height}
                  alt={t.name}
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="tc-txt">
                <h3>{t.name}</h3>
                <p class="tc-role">{t.role}</p>
                <p class="tc-desc">{t.desc}</p>
                <p class="tc-quote">{t.quote}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    {/* mobile: Adam duży, pozostali w siatce */}
    <div class="team-mob">
      <div class="tm-lead" data-rev="soft">
        <img
          src={ADAM_IMG.src}
          width={ADAM_IMG.width}
          height={ADAM_IMG.height}
          alt={`${ADAM.name} — ${ADAM.role.toLowerCase()}`}
          loading="lazy"
          decoding="async"
        />
        <i aria-hidden="true"></i>
        <div>
          <h3>{ADAM.name}</h3>
          <span>{ADAM.role}</span>
        </div>
      </div>
      <blockquote class="tm-quote" data-rev>
        <p>{ADAM.quote} <em>{ADAM.note}</em></p>
      </blockquote>
      <div class="tm-grid">
        {
          RESZTA.map((t) => (
            <div class="tm-cell" data-rev>
              <div>
                <img
                  src={TEAM_IMAGES[t.name].src}
                  width={TEAM_IMAGES[t.name].width}
                  height={TEAM_IMAGES[t.name].height}
                  alt={t.name}
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <h3>{t.name}</h3>
              <p class="tm-role">{t.role}</p>
              <p>{t.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  /* ── mobile ── */
  .team {
    padding: 44px 0 46px;
    background: #fff;
  }
  .team-in {
    width: 100%;
    max-width: var(--col);
    margin-inline: auto;
    padding-inline: var(--pad);
  }
  .team-van {
    position: relative;
    height: 74px;
  }
  .team-van img {
    position: absolute;
    right: -8px;
    bottom: -32px;
    width: clamp(180px, 59.5vw, 250px);
    height: auto;
    z-index: 0;
  }
  .team-kick {
    position: relative;
    z-index: 1;
    font-family: var(--font-display), sans-serif;
    font-weight: 500;
    font-size: clamp(10px, 2.82vw, 12px);
    line-height: 1;
    letter-spacing: 0.2em;
    /* eksport --gr (~4.0:1 na bieli) — podbite do --accent-ink (axe) */
    color: var(--accent-ink);
    margin-bottom: 14px;
  }
  h2 {
    position: relative;
    z-index: 1;
    font-family: var(--font-display), sans-serif;
    font-weight: 200;
    font-size: clamp(25px, 7.69vw, 33px);
    line-height: 1.2;
    color: var(--ink);
  }
  .team-rule {
    width: 44px;
    height: 1px;
    background: rgba(26, 26, 26, 0.3);
    margin: 16px 0;
  }
  .team-intro {
    position: relative;
    z-index: 1;
    margin-bottom: 22px;
    font-family: var(--font-display), sans-serif;
    font-weight: 200;
    font-size: clamp(13.5px, 3.85vw, 16px);
    line-height: 1.53;
    color: var(--muted);
    text-wrap: pretty;
  }
  .team-count,
  .team-hold {
    display: none;
  }

  .tm-lead {
    border-radius: 8px;
    overflow: hidden;
    position: relative;
    height: clamp(320px, 102.6vw, 440px);
    background: #e5e1da;
  }
  .tm-lead img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 16%;
  }
  .tm-lead i {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0) 52%,
      rgba(0, 0, 0, 0.62) 100%
    );
  }
  .tm-lead div {
    position: absolute;
    left: 20px;
    right: 20px;
    bottom: 18px;
    color: #fff;
  }
  .tm-lead h3 {
    margin-bottom: 3px;
    font-family: var(--font-display), sans-serif;
    font-weight: 300;
    font-size: clamp(20px, 5.9vw, 25px);
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.45);
  }
  .tm-lead span {
    font-family: var(--font-display), sans-serif;
    font-weight: 500;
    font-size: 10.5px;
    line-height: 1.5;
    letter-spacing: 0.16em;
    color: rgba(255, 255, 255, 0.85);
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.45);
  }
  .tm-quote {
    margin: 14px 0 22px;
  }
  .tm-quote p {
    font-family: var(--font-serif), serif;
    font-style: italic;
    font-weight: 500;
    font-size: clamp(18px, 5.13vw, 21px);
    line-height: 1.4;
    color: var(--ink);
    text-wrap: pretty;
  }
  .tm-quote em {
    font-family: var(--font-display), sans-serif;
    font-style: normal;
    font-weight: 200;
    font-size: clamp(12.5px, 3.46vw, 14px);
    /* eksport .55 — podbite do --faint (ratchet axe) */
    color: var(--faint);
  }
  .tm-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
  .tm-cell > div {
    border-radius: 8px;
    overflow: hidden;
    height: clamp(160px, 51.3vw, 220px);
    position: relative;
    background: #e5e1da;
  }
  .tm-cell img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 20%;
  }
  .tm-cell h3 {
    margin: 12px 0 3px;
    font-family: var(--font-display), sans-serif;
    font-weight: 300;
    font-size: clamp(17px, 4.87vw, 20px);
    color: var(--ink);
  }
  .tm-role {
    font-family: var(--font-display), sans-serif;
    font-weight: 500;
    font-size: 9.5px;
    line-height: 1.5;
    letter-spacing: 0.14em;
    /* eksport --gr — podbite do --accent-ink (axe) */
    color: var(--accent-ink);
    margin-bottom: 8px;
  }
  .tm-cell > p {
    font-family: var(--font-display), sans-serif;
    font-weight: 200;
    font-size: clamp(12.5px, 3.46vw, 14px);
    line-height: 1.48;
    color: var(--muted);
    text-wrap: pretty;
  }

  /* ════ DESKTOP ≥1024 (para: ONAS_DESKTOP_MIN_PX) ════ */
  @media (min-width: 1024px) {
    .team {
      position: relative;
      padding: 0;
      background: #15130f;
    }
    /* scena przypięta uzbrajana przez js-motion (wzorzec scen 4.2);
       bez JS / przy reduce: sekcja w flow, tor przewijany natywnie */
    :global(html.js-motion) .team {
      height: 300vh;
    }
    .team-in {
      max-width: none;
      padding: 0;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }
    :global(html.js-motion) .team-in {
      position: sticky;
      top: 0;
      height: 100vh;
    }
    .team-head {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 40px;
      padding-block: clamp(84px, 9.03vw, 130px) 0;
      padding-inline: var(--pad);
    }
    .team-headL {
      max-width: 620px;
    }
    .team-van {
      display: none;
    }
    .team-kick {
      font-size: clamp(10.5px, 0.8vw, 11.5px);
      letter-spacing: 0.22em;
      color: #7fd0a2;
      margin-bottom: 18px;
    }
    h2 {
      font-size: clamp(38px, 3.89vw, 56px);
      line-height: 1.08;
      color: #fff;
    }
    .team-rule,
    .team-intro {
      display: none;
    }
    .team-count {
      display: flex;
      align-items: baseline;
      gap: 8px;
    }
    .team-count b {
      font-family: var(--font-mono), monospace;
      font-weight: 500;
      font-size: clamp(22px, 1.94vw, 28px);
      line-height: 1;
      color: #fff;
    }
    .team-count i {
      font-family: var(--font-mono), monospace;
      font-weight: 500;
      font-size: 13px;
      line-height: 1;
      font-style: normal;
      color: rgba(255, 255, 255, 0.4);
    }
    .team-count i::before {
      content: "/ 03";
    }
    .team-hold {
      display: block;
      flex: 1;
      position: relative;
      overflow-x: auto;
      overflow-y: hidden;
    }
    :global(html.js-motion) .team-hold {
      overflow: hidden;
    }
    .team-desk {
      display: flex;
      gap: 26px;
      align-items: center;
      height: 100%;
      width: max-content;
      padding-block: clamp(40px, 4.17vw, 60px) clamp(54px, 5.56vw, 80px);
      padding-inline: var(--pad);
      box-sizing: border-box;
    }
    .tc {
      flex: none;
      width: clamp(420px, 38.9vw, 560px);
      height: clamp(400px, 36.1vw, 520px);
      display: flex;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 10px;
      overflow: hidden;
    }
    .tc-img {
      width: 44.6%;
      flex: none;
      position: relative;
      overflow: hidden;
      background: #231f1b;
    }
    .tc-img img {
      position: absolute;
      top: 0;
      bottom: 0;
      left: -7%;
      width: 114%;
      height: 100%;
      object-fit: cover;
      object-position: 50% 18%;
    }
    .tc-txt {
      flex: 1;
      padding: clamp(28px, 2.78vw, 40px) clamp(24px, 2.36vw, 34px);
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    .tc-txt h3 {
      font-family: var(--font-display), sans-serif;
      font-weight: 300;
      font-size: clamp(28px, 2.5vw, 36px);
      color: #fff;
    }
    .tc-role {
      font-family: var(--font-display), sans-serif;
      font-weight: 500;
      font-size: 10.5px;
      line-height: 1.6;
      letter-spacing: 0.16em;
      color: #7fd0a2;
      margin: 8px 0 22px;
    }
    .tc-desc {
      font-family: var(--font-display), sans-serif;
      font-weight: 200;
      font-size: clamp(14px, 1.08vw, 15.5px);
      line-height: 1.65;
      color: rgba(255, 255, 255, 0.75);
      text-wrap: pretty;
    }
    .tc-quote {
      margin-top: 20px;
      font-family: var(--font-serif), serif;
      font-style: italic;
      font-weight: 500;
      font-size: clamp(18px, 1.46vw, 21px);
      line-height: 1.4;
      color: rgba(255, 255, 255, 0.92);
      text-wrap: pretty;
    }
    .team-mob {
      display: none;
    }
  }
</style>
