---
// Widok /kategorie/ (część 4.3; eksport: docs/design/kategorie.html —
// TYLKO mobile, desktop redirectuje na /oferta/). Lista 6 kafli
// (przycisków) otwierających kartę kategorii (D-OK5) + CTA finałowe
// (kt-cta) → /kontakt/; tło = reuse ko-bg.webp (D-OK4).
//
// SAME karty (6 sheetów `#kat-<slug>` + mechanika otwierania) mieszkają
// od rundy poprawek w KategorieSheets.astro — komponencie
// współdzielonym z / i /oferta/ (D-P2); renderuje go strona
// (KategoriePage), nie ta sekcja.
import { CONTACT_PATH } from "@/lib/routes";
import { OFERTA_CATEGORIES } from "./oferta-content";
import { ofertaImage } from "./oferta-images";
import ctaBg from "@/assets/home/ko-bg.webp";
---

<section class="kt">
  <div class="kt-head">
    <p class="kt-kick">PEŁNA OFERTA</p>
    <h1>Przestrzeń bez kompromisów.</h1>
    <div class="kt-rule" aria-hidden="true"></div>
    <p class="kt-lead">
      Wierzymy, że perfekcja tkwi w detalach, a słowo „niemożliwe” nie istnieje.
      Kompleksowo urządzamy wnętrza domów i prestiżowych lokali. Od precyzyjnych
      zabudów i montażu sprzętu AGD, aż po eleganckie dekoracje okienne. Poznaj
      pełen zakres naszych możliwości.
    </p>
  </div>

  <div class="kt-list" data-rev="soft">
    {
      OFERTA_CATEGORIES.map((c) => {
        const img = ofertaImage(c.slug);
        return (
          <button
            class="kt-card"
            type="button"
            aria-haspopup="dialog"
            aria-controls={`kat-${c.slug}`}
            data-kat={c.slug}
          >
            <img
              src={img.src}
              width={img.width}
              height={img.height}
              alt=""
              loading="lazy"
              decoding="async"
              style={`object-position:${c.pos}`}
            />
            <span class="tint" aria-hidden="true" />
            <span class="kt-num" aria-hidden="true">
              {c.num}
            </span>
            <span class="kt-txt">
              <b>{c.name}</b>
              <span>{c.blurb}</span>
            </span>
            <span class="kt-go" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <path
                  d="M6 18L18 6M18 6H8M18 6v10"
                  stroke="#1a1a1a"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </span>
          </button>
        );
      })
    }
  </div>
</section>

<section class="kt-cta">
  <img
    class="kt-cta-bg"
    src={ctaBg.src}
    width={ctaBg.width}
    height={ctaBg.height}
    alt=""
    aria-hidden="true"
    loading="lazy"
    decoding="async"
    data-par="0.08"
    data-par-scale="1.1"
  />
  <span class="kt-cta-tint" aria-hidden="true"></span>
  <div class="kt-cta-in">
    <h2 data-rev>Masz wizję swojego wnętrza?</h2>
    <a href={CONTACT_PATH} data-rev="soft">
      <span>Skontaktuj się i omówmy projekt.</span>
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path
          d="M6 18L18 6M18 6H8M18 6v10"
          stroke="#1a1a1a"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </a>
  </div>
</section>

<style>
  /* ── nagłówek listy ── */
  .kt-head {
    width: 100%;
    max-width: var(--col);
    margin-inline: auto;
    padding-inline: var(--pad);
    padding-block: clamp(18px, 6.15vw, 26px) clamp(18px, 6.67vw, 26px);
  }
  .kt-kick {
    font-family: var(--font-display), sans-serif;
    font-weight: 500;
    font-size: clamp(10px, 2.82vw, 12px);
    line-height: 1;
    letter-spacing: 0.2em;
    /* eksport .5 — podbite do --faint (drobny druk, ratchet axe) */
    color: var(--faint);
    margin-bottom: 14px;
  }
  .kt-head h1 {
    font-family: var(--font-display), sans-serif;
    font-weight: 200;
    font-size: clamp(28px, 8.72vw, 38px);
    line-height: 1.12;
    text-wrap: pretty;
  }
  .kt-rule {
    width: 44px;
    height: 1px;
    background: rgba(26, 26, 26, 0.3);
    margin: 16px 0;
  }
  .kt-lead {
    font-family: var(--font-display), sans-serif;
    font-weight: 200;
    font-size: clamp(13.5px, 3.97vw, 17px);
    line-height: 1.48;
    color: var(--muted);
    text-wrap: pretty;
  }

  /* ── kafle kategorii ── */
  .kt-list {
    display: flex;
    flex-direction: column;
    gap: clamp(11px, 3.59vw, 15px);
    width: 100%;
    max-width: var(--col);
    margin-inline: auto;
    padding-inline: var(--pad);
  }
  .kt-card {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 338 / 300;
    border-radius: 8px;
    overflow: hidden;
    background: #e5e1da;
    border: none;
    padding: 0;
    text-align: left;
    cursor: pointer;
  }
  .kt-card:hover {
    opacity: 0.96;
  }
  .kt-card img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .kt-card .tint {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0) 38%,
      rgba(0, 0, 0, 0.65) 100%
    );
  }
  .kt-num {
    position: absolute;
    left: clamp(15px, 5.13vw, 22px);
    top: clamp(14px, 4.62vw, 20px);
    font-family: var(--font-display), sans-serif;
    font-weight: 500;
    font-size: clamp(10px, 2.82vw, 12px);
    line-height: 1;
    letter-spacing: 0.2em;
    color: rgba(255, 255, 255, 0.85);
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.4);
  }
  .kt-txt {
    position: absolute;
    left: clamp(15px, 5.13vw, 22px);
    bottom: clamp(15px, 5.13vw, 22px);
    right: clamp(66px, 20.5vw, 88px);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .kt-txt b {
    font-family: var(--font-display), sans-serif;
    font-weight: 300;
    font-size: clamp(18px, 5.64vw, 24px);
    line-height: 1.18;
    color: #fff;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.45);
  }
  .kt-txt span {
    font-family: var(--font-display), sans-serif;
    font-weight: 200;
    font-size: clamp(12px, 3.33vw, 14px);
    line-height: 1.38;
    color: rgba(255, 255, 255, 0.85);
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.45);
  }
  .kt-go {
    position: absolute;
    right: clamp(12px, 4.1vw, 18px);
    bottom: clamp(12px, 4.1vw, 18px);
    width: clamp(38px, 11.8vw, 50px);
    aspect-ratio: 1;
    background: #fff;
    border-radius: 999px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
  }
  .kt-go svg {
    width: 44%;
    height: 44%;
  }

  /* ── CTA ── */
  .kt-cta {
    position: relative;
    overflow: hidden;
    margin-top: clamp(30px, 11.3vw, 44px);
    padding-block: clamp(40px, 14.9vw, 58px) clamp(44px, 15.9vw, 62px);
    background: var(--bg-dark);
  }
  .kt-cta-bg {
    position: absolute;
    inset: -24px;
    width: calc(100% + 48px);
    height: calc(100% + 48px);
    object-fit: cover;
    object-position: 10% 58%;
    filter: blur(7px);
    transform: scale(1.06);
  }
  .kt-cta-tint {
    position: absolute;
    inset: 0;
    background: rgba(22, 19, 16, 0.55);
  }
  .kt-cta-in {
    position: relative;
    width: 100%;
    max-width: var(--col);
    margin-inline: auto;
    padding-inline: var(--pad);
  }
  .kt-cta h2 {
    font-family: var(--font-display), sans-serif;
    font-weight: 200;
    font-size: clamp(24px, 7.44vw, 32px);
    line-height: 1.21;
    color: #fff;
    text-wrap: pretty;
    text-shadow: 0 1px 9px rgba(0, 0, 0, 0.5);
    margin-bottom: 26px;
  }
  .kt-cta a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    background: #fff;
    color: var(--ink);
    border-radius: 999px;
    padding: 13px clamp(18px, 6.67vw, 26px);
    font-family: var(--font-body), sans-serif;
    font-weight: 500;
    font-size: clamp(13.5px, 4.1vw, 17px);
    line-height: 1.25;
    text-decoration: none;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
  }
  .kt-cta a:hover {
    opacity: 0.94;
  }
  .kt-cta svg {
    width: clamp(22px, 6.67vw, 28px);
    height: clamp(22px, 6.67vw, 28px);
    flex: none;
  }
</style>
