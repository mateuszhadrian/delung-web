---
// CTA procesu współpracy na /oferta/ (eksport: .pr). Tło = reuse
// ko-bg.webp z 4.2 (kaszmir przygotowany pod blur; D-OK4). Mobile bez h2
// (jak eksport), desktop pełnoekranowy finał wyśrodkowany. Parallax tła
// [data-par] — oferta-motion.ts (za bramką motion).
import { PROCESS_PATH } from "@/lib/routes";
import prBg from "@/assets/home/ko-bg.webp";
---

<section class="pr">
  <img
    class="pr-bg"
    src={prBg.src}
    width={prBg.width}
    height={prBg.height}
    alt=""
    aria-hidden="true"
    loading="lazy"
    decoding="async"
    data-par="0.08"
    data-par-scale="1.16"
  />
  <span class="pr-tint" aria-hidden="true"></span>
  <div class="pr-in">
    <p class="pr-kick" data-rev>PROCES WSPÓŁPRACY</p>
    <h2 class="pr-h">Jak pracujemy?</h2>
    <p class="pr-lead" data-rev>
      Zobacz, jak wygląda współpraca z nami – od niezobowiązującej rozmowy i
      darmowego pomiaru, przez dobór detali, aż po czysty montaż całego
      wyposażenia. Twój spokój to nasz priorytet.
    </p>
    <div class="pr-btnwrap" data-rev="soft">
      <a class="pr-btn" href={PROCESS_PATH}>
        <span>Poznaj proces współpracy</span>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M6 18L18 6M18 6H8M18 6v10"
            stroke="#1a1a1a"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .pr {
    position: relative;
    overflow: hidden;
    margin-top: clamp(30px, 11.3vw, 44px);
    padding-block: clamp(40px, 14.9vw, 58px) clamp(44px, 15.9vw, 62px);
    background: var(--bg-dark);
  }
  .pr-bg {
    position: absolute;
    inset: -24px;
    width: calc(100% + 48px);
    height: calc(100% + 48px);
    object-fit: cover;
    object-position: 10% 58%;
    filter: blur(7px);
    transform: scale(1.06);
  }
  .pr-tint {
    position: absolute;
    inset: 0;
    background: rgba(22, 19, 16, 0.55);
  }
  .pr-in {
    position: relative;
    width: 100%;
    max-width: var(--col);
    margin-inline: auto;
    padding-inline: var(--pad);
  }
  .pr-kick {
    font-family: var(--font-display), sans-serif;
    font-weight: 500;
    font-size: clamp(10px, 2.82vw, 12px);
    line-height: 1;
    letter-spacing: 0.2em;
    /* eksport .65 — podbite (drobny druk na ciemnym tle, ratchet axe) */
    color: rgba(255, 255, 255, 0.75);
    margin-bottom: 16px;
  }
  .pr-h {
    display: none;
  }
  .pr-lead {
    font-family: var(--font-display), sans-serif;
    font-weight: 200;
    font-size: clamp(14px, 4.23vw, 18px);
    line-height: 1.52;
    color: rgba(255, 255, 255, 0.95);
    text-shadow: 0 1px 9px rgba(0, 0, 0, 0.5);
    margin-bottom: 28px;
    text-wrap: pretty;
  }
  .pr-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    background: #fff;
    color: var(--ink);
    border-radius: 999px;
    padding: 11px clamp(18px, 7.18vw, 28px);
    font-family: var(--font-body), sans-serif;
    font-weight: 500;
    font-size: clamp(14px, 4.36vw, 18px);
    line-height: 1.2;
    text-decoration: none;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
  }
  /* Biała pigułka na zdjęciu — hover wypełnieniem, nie
     przezroczystością (D-P4). */
  .pr-btn:hover {
    background: #f2f2f2;
  }
  .pr-btn svg {
    width: clamp(22px, 6.67vw, 28px);
    height: clamp(22px, 6.67vw, 28px);
    flex: none;
  }

  @media (min-width: 835px) and (max-width: 1023px) and (max-height: 700px) {
    .pr {
      margin-top: 26px;
    }
  }

  /* ════ DESKTOP ≥1024 (para: OFERTA_DESKTOP_MIN_PX) ════ */
  @media (min-width: 1024px) {
    .pr {
      margin-top: 0;
      min-height: 100svh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding-block: clamp(56px, 5.6vw, 80px);
      background: #12110f;
    }
    .pr-bg {
      inset: auto;
      left: 0;
      top: -10%;
      width: 100%;
      height: 120%;
      filter: blur(9px);
      transform: none;
    }
    .pr-tint {
      background: rgba(22, 19, 16, 0.58);
    }
    .pr-in {
      max-width: clamp(620px, 58.3vw, 840px);
      padding-inline: clamp(24px, 2.78vw, 40px);
      text-align: center;
    }
    .pr-kick {
      font-size: clamp(11px, 0.83vw, 12px);
      letter-spacing: 0.26em;
      margin-bottom: clamp(16px, 1.53vw, 22px);
    }
    .pr-h {
      display: block;
      font-family: var(--font-display), sans-serif;
      font-weight: 200;
      font-size: clamp(40px, 4.17vw, 60px);
      line-height: 1.1;
      color: #fff;
      text-shadow: 0 2px 16px rgba(0, 0, 0, 0.45);
    }
    .pr-lead {
      margin: clamp(18px, 1.81vw, 26px) 0 clamp(28px, 2.92vw, 42px);
      font-size: clamp(15px, 1.25vw, 18px);
      line-height: 1.6;
      color: rgba(255, 255, 255, 0.94);
    }
    .pr-btnwrap {
      display: flex;
      justify-content: center;
    }
    .pr-btn {
      justify-content: center;
      gap: clamp(10px, 1.11vw, 16px);
      padding: clamp(15px, 1.46vw, 21px) clamp(26px, 2.78vw, 40px);
      font-size: clamp(15px, 1.32vw, 19px);
      box-shadow: 0 12px 34px rgba(0, 0, 0, 0.3);
    }
    .pr-btn svg {
      width: clamp(18px, 1.53vw, 22px);
      height: clamp(18px, 1.53vw, 22px);
    }
  }

  @media (min-width: 1024px) and (max-height: 820px) {
    .pr {
      min-height: 0;
      padding-block: clamp(70px, 8vw, 110px);
    }
  }
</style>
