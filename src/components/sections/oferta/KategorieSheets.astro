    height: 44%;
  }
  .dt-spec > span {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .dt-spec b {
    font-family: var(--font-display), sans-serif;
    font-weight: 500;
    font-size: clamp(9.5px, 2.7vw, 11px);
    line-height: 1;
    letter-spacing: 0.18em;
    /* eksport .45 → --faint (ratchet axe) */
    color: var(--faint);
  }
  .dt-spec em {
    font-family: var(--font-display), sans-serif;
    font-style: normal;
    font-weight: 300;
    font-size: clamp(13px, 3.72vw, 15.5px);
    line-height: 1.31;
  }
  .dt-more {
    display: block;
    padding: 20px 0 150px;
    text-align: center;
  }
  .dt-more a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-body), sans-serif;
    font-weight: 500;
    font-size: clamp(12.5px, 3.46vw, 14.5px);
    line-height: 1;
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid rgba(26, 26, 26, 0.35);
    padding-bottom: 4px;
  }
  .dt-more a:hover {
    opacity: 0.6;
  }
  .dt-more svg {
    width: 14px;
    height: 14px;
  }
  .dt-foot {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding-block: 40px 24px;
    pointer-events: none;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0), #fff 26%);
  }
  .dt-foot-in {
    width: 100%;
    max-width: var(--col);
    margin-inline: auto;
    padding-inline: var(--pad);
  }
  .dt-foot a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    background: var(--ink);
    color: #fff;
    border-radius: 999px;
    padding: 12px clamp(18px, 6.67vw, 26px);
    pointer-events: auto;
    text-decoration: none;
  }
  .dt-foot a:hover {
    background: #2b2b2b;
  }
  .dt-foot b {
    display: block;
    font-family: var(--font-display), sans-serif;
    font-weight: 500;
    font-size: clamp(9.5px, 2.7vw, 11px);
    line-height: 1;
    letter-spacing: 0.16em;
    /* eksport .6 na --ink (~7:1 AA) — zostaje */
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: 4px;
  }
  .dt-foot em {
    display: block;
    font-family: var(--font-body), sans-serif;
    font-weight: 500;
    font-style: normal;
    font-size: clamp(14px, 4.1vw, 17px);
    line-height: 1.2;
  }
  .dt-foot svg {
    width: clamp(20px, 6.15vw, 26px);
    height: clamp(20px, 6.15vw, 26px);
    flex: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .dt-ov,
    .dt {
      transition: none;
    }
  }
</style>
