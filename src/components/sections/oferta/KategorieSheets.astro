---
// Karty kategorii — 6 pre-renderowanych bottom sheetów `#kat-<slug>`
// (D-OK5) wydzielonych z KategorieSection.astro do komponentu
// WSPÓŁDZIELONEGO przez trzy strony: /kategorie/, / i /oferta/
// (D-P2, docs/analiza-poprawki-wizualne.md — tap w kafel kategorii na
// mobile otwiera kartę W MIEJSCU, zamiast nawigować).
//
// Treść statyczna, znana w build time → zero templatingu po stronie
// klienta (świadomie inaczej niż work-detail, który klonuje <template>).
// Kontrakt overlay.ts: data-overlay + data-overlay-kind="sheet" +
// data-overlay-panel + data-overlay-drag → focus-trap, Esc, scrim,
// swipe-down i blokada scrolla za darmo.
//
// Mechanikę otwierania (kafle listy, kafle-linki, deep-link, guard progu)
// niesie kat-sheets.ts importowany NIŻEJ — dzięki temu każda strona,
// która wyrenderuje ten komponent, dostaje działające karty bez
// pamiętania o osobnym imporcie. Renderować POZA sekcjami (obok
// <Footer />): nakładki są `position: fixed`, a sekcja oferty ma pod
// motion-gate przodka z `transform` (nowy blok zawierający).
//
// Zdjęcia są `loading="lazy"` w kontenerze `hidden` — przeglądarka
// pobiera je dopiero przy otwarciu karty (koszt stron: HTML + CSS).
import { CONTACT_PATH, WORK_INDEX_PATH } from "@/lib/routes";
import { OFERTA_CATEGORIES } from "./oferta-content";
import { ofertaImage } from "./oferta-images";

// Ikony spec „W STANDARDZIE" (4 sztuki, indeksowane pozycją — eksport
// IKONY): okrąg / kwadraty / front z zawiasami / romb.
const SPEC_ICONS = [
  '<svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="6.5" stroke="#1a1a1a" stroke-width="1.4"/><circle cx="12" cy="12" r="1.6" fill="#1a1a1a"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none"><rect x="4" y="4" width="11" height="11" stroke="#1a1a1a" stroke-width="1.4"/><path d="M9 20h11V9" stroke="#1a1a1a" stroke-width="1.4"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none"><rect x="5" y="7" width="14" height="12" rx="1" stroke="#1a1a1a" stroke-width="1.4"/><path d="M9 3.5V7M15 3.5V7" stroke="#1a1a1a" stroke-width="1.4" stroke-linecap="round"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none"><path d="M12 4l8 8-8 8-8-8z" stroke="#1a1a1a" stroke-width="1.4" stroke-linejoin="round"/></svg>',
];
---

{
  OFERTA_CATEGORIES.map((c) => {
    const img = ofertaImage(c.slug);
    return (
      <div
        class="dt-ov"
        id={`kat-${c.slug}`}
        data-overlay
        data-overlay-kind="sheet"
        role="dialog"
        aria-modal="true"
        aria-labelledby={`kat-${c.slug}-title`}
        data-lenis-prevent
        hidden
      >
        <div class="dt" data-overlay-panel tabindex="-1">
          <div class="dt-grab" data-overlay-drag>
            <span aria-hidden="true" />
          </div>
          <button
            class="dt-x"
            type="button"
            data-overlay-close
            aria-label="Zamknij"
          >
            <i aria-hidden="true">
              <b />
              <b />
            </i>
          </button>
          <div class="dt-body" data-overlay-scroll>
            <div class="dt-in">
              <p class="dt-kick">
                <span>{c.num}</span> — OFERTA
              </p>
              <h2 id={`kat-${c.slug}-title`}>{c.title}</h2>
              <div class="dt-rule" aria-hidden="true" />
              <div class="dt-pic">
                <img
                  src={img.src}
                  width={img.width}
                  height={img.height}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  style={`object-position:${c.pos}`}
                />
              </div>
              <p class="dt-desc">{c.desc}</p>
              <p class="dt-h">W STANDARDZIE</p>
              <div class="dt-specs">
                {c.det.map((d, k) => (
                  <div class="dt-spec">
                    <i aria-hidden="true" set:html={SPEC_ICONS[k]} />
                    <span>
                      <b>{d.label}</b>
                      <em>{d.text}</em>
                    </span>
                  </div>
                ))}
              </div>
              <div class="dt-more">
                {/* deep-link filtra realizacji (część 4.4, D-R2) */}
                <a href={`${WORK_INDEX_PATH}#${c.slug}`}>
                  Zobacz realizacje z tej kategorii
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path
                      d="M6 18L18 6M18 6H8M18 6v10"
                      stroke="#1a1a1a"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </a>
              </div>
            </div>
          </div>
          <div class="dt-foot">
            <div class="dt-foot-in">
              <a href={CONTACT_PATH}>
                <span>
                  <b>CHCESZ WIĘCEJ SZCZEGÓŁÓW?</b>
                  <em>Skontaktuj się z nami</em>
                </span>
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path
                    d="M6 18L18 6M18 6H8M18 6v10"
                    stroke="#ffffff"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    );
  })
}

<script>
  // Otwieranie kart (kafle listy /kategorie/, kafle-linki / i /oferta/,
  // deep-link, guard progu) — ładowane ZAWSZE: to funkcja, nie dekoracja.
  import "@/components/sections/oferta/kat-sheets";
</script>

<style>
  /* ── karta kategorii (bottom sheet — kontrakt overlay.ts) ── */
  .dt-ov {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: flex-end;
    background: rgba(0, 0, 0, 0.45);
    opacity: 0;
    transition: opacity 0.32s ease;
  }
  .dt-ov[hidden] {
    display: none;
  }
  .dt-ov.is-open {
    opacity: 1;
  }
  .dt {
    position: relative;
    width: 100%;
    height: 96svh;
    background: #fff;
    border-radius: 22px 22px 0 0;
    box-shadow: 0 -12px 40px rgba(0, 0, 0, 0.18);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transform: translateY(103%);
    transition: transform 0.38s cubic-bezier(0.32, 0.72, 0.24, 1);
  }
  .dt-ov.is-open .dt {
    transform: none;
  }
  /* Panel bywa programowo fokusowany przy otwarciu dotykiem (tabindex=-1) —
     bez pierścienia; to kontener, nie kontrolka. */
  .dt:focus {
    outline: none;
  }
  .dt-grab {
    flex: none;
    height: 30px;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 12px;
    cursor: grab;
    touch-action: none;
  }
  .dt-grab span {
    width: 40px;
    height: 4px;
    border-radius: 99px;
    background: rgba(0, 0, 0, 0.14);
  }
  .dt-x {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 3;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
  }
  .dt-x:hover {
    opacity: 0.55;
  }
  .dt-x i {
    position: relative;
    width: 20px;
    height: 20px;
    display: block;
  }
  .dt-x i b {
    position: absolute;
    top: 9px;
    left: 0;
    width: 20px;
    height: 1.5px;
    background: var(--ink);
  }
  .dt-x i b:first-child {
    transform: rotate(45deg);
  }
  .dt-x i b:last-child {
    transform: rotate(-45deg);
  }
  .dt-body {
    flex: 1;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .dt-body::-webkit-scrollbar {
    display: none;
  }
  .dt-in {
    width: 100%;
    max-width: var(--col);
    margin-inline: auto;
    padding-inline: var(--pad);
  }
  .dt-kick {
    font-family: var(--font-display), sans-serif;
    font-weight: 500;
    font-size: clamp(10px, 2.82vw, 12px);
    line-height: 1;
    letter-spacing: 0.2em;
    /* eksport .5 — podbite do --faint (drobny druk, ratchet axe) */
    color: var(--faint);
    margin-bottom: 9px;
    padding-right: clamp(34px, 11.3vw, 44px);
  }
  .dt-in h2 {
    font-family: var(--font-display), sans-serif;
    font-weight: 200;
    font-size: clamp(22px, 6.67vw, 29px);
    line-height: 1.19;
    text-wrap: balance;
    padding-right: clamp(34px, 11.3vw, 44px);
  }
  .dt-rule {
    width: 44px;
    height: 1px;
    background: rgba(26, 26, 26, 0.3);
    margin-top: 12px;
  }
  .dt-pic {
    position: relative;
    margin-top: 16px;
    aspect-ratio: 338 / 190;
    overflow: hidden;
    background: #e5e1da;
  }
  .dt-pic img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .dt-desc {
    margin-top: 16px;
    font-family: var(--font-display), sans-serif;
    font-weight: 200;
    font-size: clamp(13.5px, 3.85vw, 16px);
    line-height: 1.47;
    color: var(--muted);
    text-wrap: pretty;
  }
  .dt-h {
    margin-top: 20px;
    font-family: var(--font-display), sans-serif;
    font-weight: 500;
    font-size: clamp(10px, 2.82vw, 12px);
    line-height: 1;
    letter-spacing: 0.2em;
