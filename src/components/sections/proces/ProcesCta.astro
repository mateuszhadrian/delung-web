---
// CTA kontaktu (eksport: .cta z proces.html). Mobile (<1024): jasny pas
// #eae5dd — kicker z zieloną kropką, h2 „…dostępni 24/7.", przyciski
// „Zadzwoń teraz" (tel — wariant href-only antyscrapingu, etykieta
// zostaje) i „Napisz wiadomość" → kontakt. Desktop (≥1024): pełnoekranowy
// finał na tle proces-step4 blur(7) + tint, pulsująca kropka, przycisk
// primary → kontakt + pigułki tel/mail (sloty D-CH5 — wypełnia
// fillContactSlots z navbara). Tło desktop-only przez <picture> + blank
// (fix transferu 4.2); parallax [data-par] na <picture> (proces-motion).
import { CONTACT_PATH } from "@/lib/routes";
import ctaBg from "@/assets/proces/cta-bg.webp";

const BLANK_IMG =
  "data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20width='1'%20height='1'/%3E";
---

<section class="cta">
  {/* dekoracyjne (img alt="") — bez aria-hidden na <picture> (lint) */}
  <picture class="cta-pic" data-par="0.08" data-par-scale="1.14">
    <source media="(min-width: 1024px)" srcset={ctaBg.src} />
    <img
      src={BLANK_IMG}
      width={ctaBg.width}
      height={ctaBg.height}
      alt=""
      loading="lazy"
      decoding="async"
    />
  </picture>
  <span class="cta-tint" aria-hidden="true"></span>

  <div class="cta-in">
    <p class="cta-kick" data-rev>
      <span class="cta-dot" aria-hidden="true"><b></b></span>DOSTĘPNI 24/7
    </p>
    <h2 class="cta-h--m">Masz pytania? Jesteśmy dostępni 24/7.</h2>
    <h2 class="cta-h--d">Masz pytania? Zadzwoń.</h2>
    <p class="cta-lead" data-rev>
      Zadzwoń do nas o dowolnej porze lub zostaw wiadomość przez formularz.
      Chętnie omówimy detale Twojej inwestycji.
    </p>

    {/* desktop, rząd 1: primary → kontakt */}
    <div class="cta-btns cta-btns--dtop">
      <a class="cta-primary" href={CONTACT_PATH}>
        <span>Skontaktuj się z nami</span>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M6 18L18 6M18 6H8M18 6v10"
            stroke="#fff"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>

    {/* mobile: tel (href-only — etykieta zostaje) + formularz */}
    <div class="cta-btns cta-btns--m">
      <a class="cta-dark" data-tel="href" href={CONTACT_PATH}>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"
            stroke="#fff"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        <span>Zadzwoń teraz</span>
      </a>
      <a class="cta-out" href={CONTACT_PATH}>Napisz wiadomość</a>
    </div>

    {/* desktop, rząd 2: pigułki tel/mail (sloty antyscrapingu D-CH5) */}
    <div class="cta-btns cta-btns--d">
      <a class="cta-white" data-tel hidden href={CONTACT_PATH}>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"
            stroke="#1a1a1a"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        <span data-slot>Telefon</span>
      </a>
      <a class="cta-ghost" data-mail hidden href={CONTACT_PATH}>E-mail</a>
    </div>
  </div>
</section>

<style>
  /* ── mobile: jasny pas ── */
  .cta {
    position: relative;
    overflow: hidden;
    background: #eae5dd;
    padding: 46px 0 52px;
  }
  .cta-pic,
  .cta-tint {
    display: none;
  }
  .cta-in {
    position: relative;
    width: 100%;
    max-width: var(--col);
    margin-inline: auto;
    padding-inline: var(--pad);
  }
  .cta-kick {
    display: flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-display), sans-serif;
    font-weight: 500;
    font-size: clamp(9.5px, 2.7vw, 11px);
    line-height: 1;
    letter-spacing: 0.2em;
    /* eksport .55 — podbite do --faint (ratchet axe) */
    color: var(--faint);
    margin-bottom: 16px;
  }
  .cta-dot {
    position: relative;
    width: 7px;
    height: 7px;
    flex: none;
    border-radius: 999px;
    background: var(--accent);
  }
  .cta-dot b {
    display: none;
  }
  .cta-h--m,
  .cta-h--d {
    font-family: var(--font-display), sans-serif;
    font-weight: 200;
    font-size: clamp(24px, 7.18vw, 31px);
    line-height: 1.25;
    color: var(--ink);
    text-wrap: pretty;
  }
  .cta-h--d {
    display: none;
  }
  .cta-lead {
    margin: 14px 0 26px;
    font-family: var(--font-display), sans-serif;
    font-weight: 200;
    font-size: clamp(13.5px, 3.85vw, 16px);
    line-height: 1.53;
    color: var(--muted);
    text-wrap: pretty;
  }
  .cta-btns {
    display: flex;
    gap: 10px;
  }
  .cta-btns a {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    border-radius: 999px;
    padding: 15px 10px;
    font-family: var(--font-body), sans-serif;
    font-weight: 500;
    font-size: clamp(13.5px, 3.85vw, 16px);
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
  }
  .cta-btns svg {
    width: 17px;
    height: 17px;
    flex: none;
  }
  .cta-dark {
    flex: 1.15;
    background: var(--ink);
    color: #fff;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
  }
  .cta-dark:hover {
    background: #2b2b2b;
  }
  .cta-out {
    flex: 1;
    border: 1px solid rgba(26, 26, 26, 0.4);
    color: var(--ink);
  }
  .cta-out:hover {
    background: rgba(26, 26, 26, 0.04);
  }
  .cta-btns--dtop,
  .cta-btns--d {
    display: none;
  }

  /* ════ DESKTOP ≥1024 (para: PROCES_DESKTOP_MIN_PX) ════ */
  @media (min-width: 1024px) {
    .cta {
      background: #12110f;
      padding: 0;
      min-height: clamp(480px, 44.4vw, 640px);
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .cta-pic {
      display: block;
      position: absolute;
      left: 0;
      top: -10%;
      width: 100%;
      height: 120%;
    }
    .cta-pic img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: 50% 55%;
      filter: blur(7px);
    }
    .cta-tint {
      display: block;
      position: absolute;
      inset: 0;
      background: rgba(22, 19, 16, 0.6);
    }
    .cta-in {
      max-width: 820px;
      text-align: center;
      color: #fff;
      padding: 40px;
    }
    .cta-kick {
      display: inline-flex;
      font-size: clamp(10px, 0.76vw, 11px);
      /* eksport .72 — wystarcza na ciemnym tincie, lekko podbite */
      color: rgba(255, 255, 255, 0.75);
      margin-bottom: 20px;
    }
    .cta-dot {
      width: 8px;
      height: 8px;
    }
    .cta-dot b {
      display: block;
      position: absolute;
      inset: 0;
      border-radius: 999px;
      background: var(--accent);
      animation: dxpulse 2.4s ease-out infinite;
    }
    .cta-h--m {
      display: none;
    }
    .cta-h--d {
      display: block;
      font-size: clamp(40px, 3.89vw, 56px);
      line-height: 1.1;
      color: #fff;
      text-shadow: 0 2px 14px rgba(0, 0, 0, 0.45);
    }
    .cta-lead {
      margin: 22px 0 36px;
      font-size: clamp(15.5px, 1.22vw, 17.5px);
      line-height: 1.62;
      color: rgba(255, 255, 255, 0.92);
      text-shadow: 0 1px 9px rgba(0, 0, 0, 0.5);
    }
    .cta-btns {
      justify-content: center;
      gap: 16px;
      flex-wrap: wrap;
    }
    .cta-btns a {
      padding: clamp(13px, 1.18vw, 17px) clamp(24px, 2.36vw, 34px);
      font-size: clamp(15px, 1.18vw, 17px);
    }
    .cta-btns--m {
      display: none;
    }
    .cta-btns--dtop {
      display: flex;
      margin-bottom: 20px;
    }
    .cta-btns--d {
      display: flex;
    }
    .cta-primary {
      background: var(--ink);
      color: #fff;
      padding: clamp(18px, 1.67vw, 24px) clamp(30px, 3.05vw, 44px);
      font-size: clamp(17px, 1.46vw, 21px);
      box-shadow: 0 12px 34px rgba(0, 0, 0, 0.32);
    }
    .cta-primary:hover {
      background: #2b2b2b;
    }
    .cta-primary svg {
      width: 22px;
      height: 22px;
    }
    .cta-white {
      background: #fff;
      color: var(--ink);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    }
    /* Biała pigułka na zdjęciu — hover wypełnieniem, nie
       przezroczystością (D-P4); `cta-ghost` niżej zostaje szklany
       z designu (tam hover DOMYKA tło, a nie rozrzedza). */
    .cta-white:hover {
      background: #f2f2f2;
    }
    .cta-ghost {
      border: 1px solid rgba(255, 255, 255, 0.65);
      color: #fff;
      background: rgba(255, 255, 255, 0.08);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
    }
    .cta-ghost:hover {
      background: rgba(255, 255, 255, 0.18);
    }
    .cta-white[hidden],
    .cta-ghost[hidden] {
      display: none;
    }
  }

  @keyframes dxpulse {
    0%,
    100% {
      transform: scale(1);
      opacity: 1;
    }
    50% {
      transform: scale(2.4);
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cta-dot b {
      animation: none;
    }
  }
</style>
