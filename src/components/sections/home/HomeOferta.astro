---
// Zajawka oferty (eksport: .of). Mobile: karuzela 3 kafli (scroll-snap,
// gotchas sections.md) + CTA „Zobacz pełną ofertę" → /kategorie/ (tam
// mieszka komplet 6 kategorii; desktopowy odpowiednik „Sprawdź ofertę"
// prowadzi na /oferta/ — duplikat per-breakpoint). Desktop przy motion OK
// (html.js-motion): scena przypięta 300vh — poziomy tor 6 kafli napędzany
// postępem scrolla (home-scroll.ts), licznik 01/06, CTA w pasie pod kaflami.
// Fallback desktop (reduce / bez JS): sekcja w flow, tor jako zwykły
// overflow-x — pełna treść bez ruchu (D-SG9).
// Dane kafli = treści marketingowe eksportu 1:1 (D-SG4) w
// home-oferta-content.ts; categories.ts (kontrakt CMS) nietknięte —
// kafel niesie SLUG kategorii i linkuje `/oferta/#<slug>` (D-P1:
// desktop otwiera tę zakładkę), a poniżej progu desktop tap otwiera
// kartę-sheet W MIEJSCU (D-P2, kat-sheets.ts; href zostaje fallbackiem
// bez JS). Mapowanie slug → zdjęcie trzymamy tutaj (dane w .ts muszą
// zostać czyste pod unit test — wzorzec oferta-images.ts).
import type { CategorySlug } from "@/lib/categories";
import { KATEGORIE_PATH, OFERTA_PATH } from "@/lib/routes";
import HomeCta from "./HomeCta.astro";
import { HOME_KAFLE } from "./home-oferta-content";
import catKuchnie from "@/assets/home/cat-kuchnie.webp";
import catSzafy from "@/assets/home/cat-szafy.webp";
import catKomercyjne from "@/assets/home/cat-komercyjne.webp";
import catDekoracje from "@/assets/home/cat-dekoracje.webp";
import catLazienki from "@/assets/home/cat-lazienki.webp";
import catNietypowe from "@/assets/home/cat-nietypowe.webp";

const IMGS: Partial<Record<CategorySlug, typeof catKuchnie>> = {
  kuchnie: catKuchnie,
  "szafy-garderoby": catSzafy,
  "wnetrza-komercyjne": catKomercyjne,
  "dekoracje-okienne": catDekoracje,
  "zabudowy-lazienkowe": catLazienki,
  "meble-nietypowe": catNietypowe,
};

const KAFLE = HOME_KAFLE.map((k) => ({ ...k, img: IMGS[k.slug]! }));
---

<section class="of" data-home-of>
  <div class="of-pin">
    <div class="of-in">
      <p class="kick" data-rev>OFERTA</p>
      <h2 data-rev>Co tworzymy?</h2>
      <div class="rule" data-rev></div>
      <p class="of-lead" data-rev>
        Kompleksowo urządzamy domy oraz lokale biznesowe. Od precyzyjnych mebli
        i AGD, po eleganckie dekoracje okienne.
      </p>
      <p class="of-count" data-ofcount aria-hidden="true">01 / 06</p>
      <p class="of-hint" aria-hidden="true">
        <span>PRZEWIJAJ DALEJ</span>
        <svg viewBox="0 0 24 24" fill="none">
          <path
            d="M5 12h14M13 6l6 6-6 6"
            stroke="#1a1a1a"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </p>
    </div>
    <div class="of-hold" data-ofhold>
      <div class="of-track" data-oftrack data-rev>
        {
          KAFLE.map((k) => (
            <a
              class:list={["cat", { xtra: !k.mobile }]}
              href={`${OFERTA_PATH}#${k.slug}`}
              data-kat-link={k.slug}
            >
              <img
                src={k.img.src}
                width={k.img.width}
                height={k.img.height}
                alt={k.name}
                loading="lazy"
                decoding="async"
                style={`object-position:${k.pos}`}
              />
              <span class="cat-scrim" aria-hidden="true" />
              <span class="cat-num" aria-hidden="true">
                {k.num}
              </span>
              <span class="cat-txt">
                <span class="cat-sub">{k.sub}</span>
                <span class="cat-name">{k.name}</span>
                <span class="cat-nameM">{k.nameM}</span>
              </span>
              <span class="cat-arr" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none">
                  <path
                    d="M6 18L18 6M18 6H8M18 6v10"
                    stroke="#fff"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
            </a>
          ))
        }
      </div>
      <div class="of-cta" data-ofcta data-rev>
        {
          /* Duplikat per-breakpoint (wzorzec 4.3/4.5) zamiast jednego
            linku z dwiema etykietami: komplet 6 kategorii mieszka na
            mobile w /kategorie/ (karuzela pokazuje 3), a na desktopie
            w zakładkach /oferta/. W drzewie dostępności zawsze jeden
            egzemplarz — drugi na display:none. */
        }
        <HomeCta class="of-ctaD" href={OFERTA_PATH}>Sprawdź ofertę</HomeCta>
        <HomeCta class="of-ctaM" href={KATEGORIE_PATH}>
          Zobacz pełną ofertę
        </HomeCta>
      </div>
    </div>
  </div>
</section>

<style>
  .of {
    padding: 40px 0 0;
    background: #fff;
  }
  .of-in {
    width: 100%;
    max-width: var(--col);
    margin-inline: auto;
    padding-block: 0 22px;
    padding-inline: var(--pad);
  }
  .kick {
    font-family: var(--font-display), sans-serif;
    font-weight: 500;
    font-size: clamp(10px, 2.82vw, 12px);
    line-height: 1;
    letter-spacing: 0.2em;
    /* eksport --gr: drobny kicker na bieli → --accent-ink (AA, lekcja 2) */
    color: var(--accent-ink);
    margin-bottom: 14px;
  }
  h2 {
    font-family: var(--font-display), sans-serif;
    font-weight: 200;
    font-size: clamp(25px, 7.69vw, 33px);
    line-height: 1.2;
    text-wrap: pretty;
  }
  .rule {
    width: 44px;
    height: 1px;
    background: rgba(26, 26, 26, 0.3);
    margin: 16px 0;
  }
  .of-lead {
    font-family: var(--font-display), sans-serif;
    font-weight: 200;
    font-size: clamp(13.5px, 3.97vw, 17px);
    line-height: 1.48;
    color: var(--muted);
    text-wrap: pretty;
  }
  .of-count,
  .of-hint {
    display: none;
  }

  /* karuzela na pełną szerokość ekranu; wcięcie zrównane z kolumną tekstu */
  .of-track {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    padding-block: 6px 4px;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding-inline: max(
      var(--pad),
      calc((100vw - var(--col)) / 2 + var(--pad))
    );
    width: 100%;
    box-sizing: border-box;
  }
  .of-track::-webkit-scrollbar {
    display: none;
  }
  .cat {
    flex: none;
    width: min(300px, 80vw);
    height: clamp(420px, 128vw, 540px);
    border-radius: 8px;
    overflow: hidden;
    position: relative;
    display: block;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    background: #e5e1da;
    text-decoration: none;
  }
  .cat.xtra {
    display: none;
  }
  .cat img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cat-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0) 42%,
      rgba(0, 0, 0, 0.6) 100%
    );
  }
  .cat-num {
    display: none;
  }
  .cat-txt {
    position: absolute;
    left: 20px;
    bottom: 22px;
    right: 76px;
    display: block;
  }
  .cat-sub {
    display: block;
    font-family: var(--font-display), sans-serif;
    font-weight: 500;
    font-size: clamp(9px, 2.44vw, 10.5px);
    line-height: 1;
    letter-spacing: 0.18em;
    color: rgba(255, 255, 255, 0.8);
    text-transform: uppercase;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.4);
  }
  .cat-name {
    display: none;
  }
  .cat-nameM {
    display: block;
    margin-top: 8px;
    font-family: var(--font-display), sans-serif;
    font-weight: 300;
    font-size: clamp(18px, 5.38vw, 23px);
    line-height: 1.24;
    color: #fff;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.45);
  }
  .cat-arr {
    position: absolute;
    right: 16px;
    bottom: 16px;
    width: 46px;
    height: 46px;
    border: 1px solid rgba(255, 255, 255, 0.75);
    border-radius: 999px;
    display: flex;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(2px);
  }
  .cat-arr svg {
    width: 19px;
    height: 19px;
  }
  .of-cta {
    width: 100%;
    max-width: var(--col);
    margin-inline: auto;
    padding-block: 22px 0;
    padding-inline: var(--pad);
  }
  /* Widoczny zawsze JEDEN egzemplarz CTA (duplikat per-breakpoint). */
  .of-cta :global(.of-ctaD) {
    display: none;
  }

  /* ════ DESKTOP ≥1024 (para: HOME_DESKTOP_MIN_PX) ════ */
  @media (min-width: 1024px) {
    .of {
      padding: clamp(60px, 6vw, 90px) 0 clamp(40px, 4vw, 60px);
    }
    .kick {
      font-size: clamp(10.5px, 0.83vw, 12px);
      letter-spacing: 0.22em;
      margin-bottom: 18px;
    }
    h2 {
      font-size: clamp(38px, 3.89vw, 56px);
      line-height: 1.08;
    }
    .rule {
      margin: 22px 0;
    }
    .of-lead {
      font-size: clamp(15px, 1.18vw, 17px);
      line-height: 1.55;
    }
    .of-track {
      gap: 26px;
      padding-block: 20px 20px;
      scroll-snap-type: none;
    }
    .cat {
      width: clamp(300px, 30.6vw, 440px);
      height: clamp(400px, 40.3vw, 580px);
      scroll-snap-align: none;
    }
    .cat.xtra {
      display: block;
    }
    .cat img {
      left: -7%;
      /* bez tego preflight Tailwinda (`img { max-width: 100% }`) ścina 114%
         do 100% i kafel odsłania jasne tło pasem 30,8 px z PRAWEJ — ta sama
         pułapka co w hero i przy kaflach realizacji (D-U1) */
      max-width: none;
      width: 114%;
    }
    .cat-num {
      display: block;
      position: absolute;
      left: 24px;
      top: 22px;
      font-family: var(--font-mono), monospace;
      font-weight: 500;
      font-size: 13px;
      line-height: 1;
      color: rgba(255, 255, 255, 0.85);
      text-shadow: 0 1px 6px rgba(0, 0, 0, 0.5);
    }
    .cat-txt {
      left: 24px;
      bottom: 26px;
      right: 24px;
    }
    .cat-sub {
      font-size: 11px;
      letter-spacing: 0.2em;
    }
    .cat-name {
      display: block;
      margin-top: 10px;
      font-family: var(--font-display), sans-serif;
      font-weight: 300;
      font-size: clamp(22px, 2.08vw, 30px);
      line-height: 1.2;
      color: #fff;
      text-shadow: 0 1px 8px rgba(0, 0, 0, 0.45);
    }
    .cat-nameM,
    .cat-arr {
      display: none;
    }
    .of-cta :global(.of-ctaD) {
      display: flex;
    }
    .of-cta :global(.of-ctaM) {
      display: none;
    }
    /* CTA — biała pigułka jak w eksporcie (tor leży na białym tle) */
    .of-cta {
      max-width: none;
      display: flex;
      justify-content: flex-end;
      padding-inline: var(--pad);
    }
    .of-cta :global(.btn-dark) {
      background: #fff;
      color: var(--ink);
      border: 1px solid rgba(26, 26, 26, 0.4);
      box-shadow: none;
      white-space: nowrap;
      padding: 14px 28px;
      font-size: clamp(14px, 1.04vw, 15px);
    }
    /* Hover NIEPRZEZROCZYSTY (D-P4): półprzezroczysta czerń zastępowała
       białe tło i przez przycisk prześwitywały kafle toru — najbardziej
       na niskim ekranie, gdzie CTA sceny przypiętej leży na zdjęciach.
       #f2f2f2 = te same 5% czerni, tyle że wypełnieniem. */
    .of-cta :global(.btn-dark:hover) {
      background: #f2f2f2;
    }
    .of-cta :global(.btn-dark svg) {
      width: 18px;
      height: 18px;
    }

    /* ── scena przypięta (tylko html.js-motion — D-SG9) ── */
    :global(html.js-motion) .of {
      height: 300vh;
      position: relative;
      padding: 0;
    }
    :global(html.js-motion) .of-pin {
      position: sticky;
      top: 0;
      height: 100vh;
      overflow: hidden;
      background: #fff;
      display: flex;
    }
    :global(html.js-motion) .of-in {
      width: clamp(320px, 29.9vw, 430px);
      flex: none;
      max-width: none;
      margin: 0;
      padding-block: clamp(104px, 10.4vw, 150px) 0;
      padding-right: clamp(20px, 2.08vw, 30px);
      padding-left: var(--pad);
      box-sizing: border-box;
    }
    :global(html.js-motion) .of-count {
      display: block;
      font-family: var(--font-mono), monospace;
      font-weight: 500;
      font-size: 15px;
      line-height: 1;
      color: var(--ink);
      margin-top: clamp(34px, 3.89vw, 56px);
    }
    :global(html.js-motion) .of-hint {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-top: clamp(44px, 5.56vw, 80px);
      /* eksport .45 — podbite do --faint (drobny druk, ratchet axe) */
      color: var(--faint);
      font-family: var(--font-display), sans-serif;
      font-weight: 500;
      font-size: 10px;
      line-height: 1;
      letter-spacing: 0.26em;
    }
    :global(html.js-motion) .of-hint svg {
      width: 15px;
      height: 15px;
    }
    :global(html.js-motion) .of-hold {
      flex: 1;
      position: relative;
      overflow: hidden;
    }
    :global(html.js-motion) .of-track {
      display: flex;
      gap: 26px;
      align-items: center;
      height: 100%;
      width: max-content;
      max-width: none;
      overflow: visible;
      padding-block: clamp(90px, 9.03vw, 130px) 60px;
      padding-right: var(--pad);
      padding-left: 20px;
      box-sizing: border-box;
      transition: transform 0.1s linear;
    }
    :global(html.js-motion) .of-cta {
      position: absolute;
      right: var(--pad);
      bottom: 58px;
      z-index: 2;
      width: auto;
      max-width: none;
      padding: 0;
      display: block;
    }
  }
</style>
