---
// Banner CTA kontaktu (eksport: .ko) — finał strony głównej z kotwicą
// #contact (stare linki /#contact + kontrakt testów). Tło kaszmir pod
// blur + tint; mobile: wiersze TELEFON/E-MAIL, desktop: duży przycisk
// „Skontaktuj się z nami" + pigułki tel/mail. Numer i adres wg D-CH5
// (antyscraping): kotwice [data-tel]/[data-mail] startują hidden
// z placeholderem /kontakt/, wypełnia je fillContactSlots z chrome'u
// (wariant [data-slot] — ikona i etykieta zostają). Desktopowe
// odzoomowanie tła — home-scroll.
import { CONTACT_PATH } from "@/lib/routes";
import koBg from "@/assets/home/ko-bg.webp";
---

<section class="ko" id="contact" data-home-ko>
  <img
    class="ko-bg"
    src={koBg.src}
    width={koBg.width}
    height={koBg.height}
    alt=""
    aria-hidden="true"
    loading="lazy"
    decoding="async"
    data-par="0.06"
    data-par-scale="1.1"
  />
  <span class="ko-tint" aria-hidden="true"></span>
  <div class="ko-in">
    <p class="kick" data-rev>KONTAKT</p>
    <h2 data-rev>Stwórzmy Twoją przestrzeń</h2>
    <div class="ko-rule" data-rev></div>
    <p class="ko-lead" data-rev>
      Masz pytania lub gotowy projekt? Zadzwoń lub zostaw wiadomość — odezwiemy
      się najszybciej, jak to możliwe.
    </p>
    <div class="ko-main">
      <a href={CONTACT_PATH}>
        Skontaktuj się z nami
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M6 18L18 6M18 6H8M18 6v10"
            stroke="#fff"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>
    <div class="ko-rows" data-rev>
      <a class="ko-row ko-row--tel" data-tel href={CONTACT_PATH} hidden>
        <span class="ko-ic" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <path
              d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"
              stroke="#fff"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </span>
        <span class="ko-cell">
          <span class="ko-lbl">TELEFON</span>
          <span class="ko-val" data-slot></span>
        </span>
      </a>
      <a class="ko-row" data-mail href={CONTACT_PATH} hidden>
        <span class="ko-ic" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <rect
              x="2"
              y="4"
              width="20"
              height="16"
              rx="2"
              stroke="#fff"
              stroke-width="1.5"></rect>
            <path
              d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"
              stroke="#fff"
              stroke-width="1.5"
              stroke-linecap="round"></path>
          </svg>
        </span>
        <span class="ko-cell">
          <span class="ko-lbl">E-MAIL</span>
          <span class="ko-val" data-slot></span>
        </span>
      </a>
    </div>
  </div>
</section>

<style>
  .ko {
    margin-top: 44px;
    position: relative;
    overflow: hidden;
    padding: 52px 0 56px;
    background: var(--bg-dark);
  }
  .ko-bg {
    position: absolute;
    inset: -24px;
    width: calc(100% + 48px);
    height: calc(100% + 48px);
    object-fit: cover;
    object-position: 10% 58%;
    filter: blur(7px);
    transform: scale(1.06);
  }
  .ko-tint {
    position: absolute;
    inset: 0;
    background: rgba(22, 19, 16, 0.62);
  }
  .ko-in {
    position: relative;
    width: 100%;
    max-width: var(--col);
    margin-inline: auto;
    padding-inline: var(--pad);
    color: #fff;
  }
  .kick {
    font-family: var(--font-display), sans-serif;
    font-weight: 500;
    font-size: clamp(10px, 2.82vw, 12px);
    line-height: 1;
    letter-spacing: 0.2em;
    /* eksport .65 — podbite (drobny druk na ciemnym tle, ratchet axe) */
    color: rgba(255, 255, 255, 0.75);
    margin-bottom: 14px;
  }
  h2 {
    font-family: var(--font-display), sans-serif;
    font-weight: 200;
    font-size: clamp(25px, 7.69vw, 33px);
    line-height: 1.2;
    text-shadow: 0 1px 9px rgba(0, 0, 0, 0.5);
    text-wrap: pretty;
  }
  .ko-rule {
    width: 44px;
    height: 1px;
    background: rgba(255, 255, 255, 0.5);
    margin: 16px 0;
  }
  .ko-lead {
    margin-bottom: 24px;
    font-family: var(--font-display), sans-serif;
    font-weight: 200;
    font-size: clamp(13.5px, 3.97vw, 17px);
    line-height: 1.48;
    color: rgba(255, 255, 255, 0.95);
    text-shadow: 0 1px 9px rgba(0, 0, 0, 0.5);
    text-wrap: pretty;
  }
  .ko-rows {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .ko-row {
    display: flex;
    align-items: center;
    gap: 14px;
    border: 1px solid rgba(255, 255, 255, 0.6);
    border-radius: 8px;
    padding: 16px 18px;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(5px);
    color: #fff;
    text-decoration: none;
  }
  .ko-row:hover {
    background: rgba(255, 255, 255, 0.18);
  }
  .ko-row[hidden] {
    display: none;
  }
  .ko-ic {
    flex: none;
    width: 44px;
    height: 44px;
    border: 1px solid rgba(255, 255, 255, 0.7);
    border-radius: 999px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .ko-ic svg {
    width: 18px;
    height: 18px;
  }
  .ko-cell {
    display: block;
  }
  .ko-lbl {
    display: block;
    font-family: var(--font-display), sans-serif;
    font-weight: 500;
    font-size: 9.5px;
    line-height: 1;
    letter-spacing: 0.2em;
    /* eksport .65 — podbite (drobny druk na ciemnym tle, ratchet axe) */
    color: rgba(255, 255, 255, 0.75);
    margin-bottom: 3px;
  }
  .ko-val {
    display: block;
    font-family: var(--font-display), sans-serif;
    font-weight: 300;
    font-size: clamp(15px, 4.36vw, 18px);
  }
  .ko-main {
    display: none;
  }

  /* ════ DESKTOP ≥1024 (para: HOME_DESKTOP_MIN_PX) ════ */
  @media (min-width: 1024px) {
    .ko {
      margin: 0;
      height: clamp(560px, 52.8vw, 760px);
      padding: 0;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .ko-bg {
      inset: -40px;
      width: calc(100% + 80px);
      height: calc(100% + 80px);
      filter: blur(9px);
      transform: scale(1.25);
    }
    .ko-tint {
      background: rgba(22, 19, 16, 0.55);
    }
    .ko-in {
      max-width: 820px;
      text-align: center;
      padding: 0 40px;
    }
    .kick {
      font-size: clamp(11px, 0.83vw, 12px);
      letter-spacing: 0.26em;
      margin-bottom: 20px;
    }
    h2 {
      font-size: clamp(44px, 4.44vw, 64px);
      line-height: 1.1;
      text-shadow: 0 2px 14px rgba(0, 0, 0, 0.5);
    }
    .ko-rule {
      display: none;
    }
    .ko-lead {
      margin: 24px 0 40px;
      font-size: clamp(16px, 1.25vw, 18px);
      line-height: 1.55;
    }
    .ko-main {
      display: flex;
      justify-content: center;
      margin-bottom: 20px;
    }
    .ko-main a {
      display: inline-flex;
      align-items: center;
      gap: 14px;
      background: var(--ink);
      color: #fff;
      border-radius: 999px;
      padding: clamp(18px, 1.67vw, 24px) clamp(30px, 3.05vw, 44px);
      font-family: var(--font-body), sans-serif;
      font-weight: 500;
      font-size: clamp(17px, 1.46vw, 21px);
      line-height: 1;
      text-decoration: none;
      box-shadow: 0 12px 34px rgba(0, 0, 0, 0.32);
    }
    .ko-main a:hover {
      background: #2b2b2b;
    }
    .ko-main svg {
      width: 22px;
      height: 22px;
      flex: none;
    }
    .ko-rows {
      flex-direction: row;
      gap: 16px;
      justify-content: center;
    }
    .ko-row {
      border: none;
      border-radius: 999px;
      padding: clamp(13px, 1.18vw, 17px) clamp(24px, 2.36vw, 34px);
      background: #fff;
      color: var(--ink);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
      backdrop-filter: none;
      gap: 12px;
      font-family: var(--font-body), sans-serif;
      font-weight: 500;
      font-size: clamp(15px, 1.18vw, 17px);
      line-height: 1;
    }
    .ko-row:hover {
      opacity: 0.92;
      background: #fff;
    }
    .ko-row:last-child {
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.65);
      color: #fff;
      backdrop-filter: blur(4px);
      box-shadow: none;
    }
    .ko-row:last-child:hover {
      background: rgba(255, 255, 255, 0.18);
    }
    .ko-ic {
      display: none;
    }
    .ko-lbl {
      display: none;
    }
    .ko-val {
      font-family: var(--font-body), sans-serif;
      font-weight: 500;
      font-size: inherit;
    }
    /* ikona słuchawki przed numerem (pigułka telefonu) — z eksportu */
    .ko-row--tel .ko-val::before {
      content: "";
      display: inline-block;
      width: 17px;
      height: 17px;
      margin-right: 12px;
      vertical-align: -3px;
      background: url("data:image/svg+xml;charset=utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='17' height='17' viewBox='0 0 24 24' fill='none'%3E%3Cpath d='M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z' stroke='%231a1a1a' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E")
        no-repeat center / contain;
    }
  }
</style>
