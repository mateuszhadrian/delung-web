---
// Przycisk CTA sekcji strony głównej wg eksportu (btn-dark / btn-out):
// pigułka z etykietą i strzałką ↗ (hover: strzałka jedzie w prawo-górę).
// Jedno źródło stylu dla CTA oferty/procesu/realizacji/o-nas.
interface Props {
  href: string;
  variant?: "dark" | "out";
  class?: string;
  /** Atrybuty przekazywane 1:1 (np. data-work-more dla testów dojścia). */
  [key: string]: unknown;
}
const { href, variant = "dark", class: className, ...rest } = Astro.props;
---

<a
  class:list={[variant === "dark" ? "btn-dark" : "btn-out", className]}
  href={href}
  {...rest}
>
  <span><slot /></span>
  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path
      d="M6 18L18 6M18 6H8M18 6v10"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </svg>
</a>

<style>
  .btn-dark,
  .btn-out {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    border-radius: 999px;
    font-family: var(--font-body), sans-serif;
    font-weight: 500;
    font-size: clamp(14px, 4.1vw, 17px);
    line-height: 1;
    text-decoration: none;
  }
  .btn-dark {
    background: var(--ink);
    color: #fff;
    padding: 14px 28px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
  }
  .btn-dark:hover {
    background: #2b2b2b;
  }
  .btn-out {
    border: 1px solid rgba(26, 26, 26, 0.4);
    color: var(--ink);
    padding: 13px 28px;
  }
  .btn-out:hover {
    background: rgba(26, 26, 26, 0.06);
  }
  svg {
    width: 24px;
    height: 24px;
    flex: none;
    transition: transform 0.55s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .btn-dark:hover svg,
  .btn-out:hover svg {
    transform: translate(4px, -4px);
  }
  @media (prefers-reduced-motion: reduce) {
    svg {
      transition: none;
    }
  }
</style>
