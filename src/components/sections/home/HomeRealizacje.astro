---
// Zajawka realizacji (eksport: .re). Dane: top 3 wpisy kolekcji wg `order`
// (wzorzec szablonowego Work.astro). Kafle NIE nawigują — otwierają detal
// (Modal desktop / BottomSheet mobile) przez współdzielony open-detail
// (instrukcja Etapu 4 pkt 2; D-SG6). „Więcej" i CTA → /realizacje/
// (data-work-more — testy dojścia). Mobile: karty w kolumnie; desktop przy
// motion OK: scena przypięta 300vh — teksty przełączane postępem, stos
// zdjęć odsłaniany clip-path (home-scroll.ts); fallback: kolumna kart.
import { getCollection } from "astro:content";
import { useTranslations } from "@/i18n/utils";
import { WORK_INDEX_PATH } from "@/lib/routes";
import { imgAt } from "@/lib/img";
import { viewProject } from "@/components/sections/work/work-data";
import WorkDetail from "@/components/sections/work/WorkDetail.astro";
import Modal from "@/components/ui/Modal.astro";
import BottomSheet from "@/components/ui/BottomSheet.astro";
import HomeCta from "./HomeCta.astro";

const t = useTranslations("pl");

const entries = await getCollection("realizacje");
// Strona główna pokazuje TYLKO pierwsze 3 realizacje (pełna lista i filtry:
// /realizacje/).
const projects = entries
  .map((e) => e.data)
  .sort((a, b) => a.order - b.order)
  .map((p) => viewProject(p))
  .slice(0, 3);
---

<section class="re" data-home-re>
  <div class="re-pin">
    <div class="re-in">
      <p class="kick" data-rev>REALIZACJE</p>
      <h2 class="mOnly" data-rev>Zobacz nasze realizacje</h2>
      <h2 class="dOnly">Nasze realizacje</h2>
      <div class="re-txts" data-retxts>
        {
          projects.map((p, i) => (
            <div class="re-tx" data-retx style={i ? "opacity:0" : undefined}>
              <p class="re-meta">{p.categoryLabel.toUpperCase()}</p>
              <h3>{p.title}</h3>
              <p>{p.description}</p>
              <a href={WORK_INDEX_PATH} data-work-more>
                Więcej
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path
                    d="M5 12h14M13 6l6 6-6 6"
                    stroke="#1a1a1a"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>
            </div>
          ))
        }
      </div>
      <div class="re-bar" aria-hidden="true"><b data-rebar></b></div>
    </div>
    <div class="re-cards" data-recards>
      {
        projects.map((p, i) => (
          <button
            type="button"
            class="rc"
            data-work-slug={p.slug}
            data-work-name={p.title}
            aria-haspopup="dialog"
            data-rev="soft"
          >
            <img
              src={imgAt(p.cover.image, "full")}
              alt={p.title}
              loading="lazy"
              decoding="async"
              style={
                p.cover.position
                  ? `object-position:${p.cover.position}`
                  : undefined
              }
              data-par="0.11"
            />
            <span class="rc-scrim" aria-hidden="true" />
            <span class="rc-idx" aria-hidden="true">
              0{i + 1} / 0{projects.length}
            </span>
            <span class="rc-txt">
              <span class="rc-tag">{p.categoryLabel}</span>
              <span class="rc-title">{p.title}</span>
            </span>
          </button>
        ))
      }
      <span class="re-pill" data-repill aria-hidden="true">
        {projects[0]?.categoryLabel}
      </span>
      <span class="re-lupa" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none">
          <circle cx="11" cy="11" r="7" stroke="#fff" stroke-width="1.5"
          ></circle>
          <path
            d="M16.8 16.8L21 21M11 8.2v5.6M8.2 11h5.6"
            stroke="#fff"
            stroke-width="1.5"
            stroke-linecap="round"></path>
        </svg>
      </span>
    </div>
    <div class="re-cta" data-rev>
      <HomeCta href={WORK_INDEX_PATH} data-work-more>
        Przeglądaj nasze realizacje
      </HomeCta>
    </div>
  </div>

  {/* Treść szczegółów per realizacja — klonowana do nakładki po kliknięciu. */}
  {
    projects.map((project) => (
      <template data-work-detail={project.slug}>
        <WorkDetail
          project={project}
          galleryLabel={t("work.gallery")}
          specsLabel={t("work.specs")}
        />
      </template>
    ))
  }
  <Modal id="work-modal" closeLabel={t("work.close")}>
    <div data-work-host></div>
  </Modal>
  <BottomSheet id="work-sheet" closeLabel={t("work.close")}>
    <div data-work-host></div>
  </BottomSheet>
</section>

<script>
  // Klik/tap w kafel → detal we właściwej nakładce (wspólny helper —
  // na desktopowej scenie przypiętej trafia zawsze bieżący, wierzchni
  // kafel: clip-path przycina też hit-testing pozostałych).
  import {
    openWorkDetail,
    sheetMQ,
  } from "@/components/sections/work/open-detail";

  const cards = document.querySelector<HTMLElement>("[data-recards]");
  cards?.addEventListener("click", (e) => {
    const card = (e.target as HTMLElement).closest<HTMLElement>(
      "[data-work-slug]",
    );
    if (!card?.dataset.workSlug) return;
    openWorkDetail(card.dataset.workSlug, card.dataset.workName ?? "");
  });

  // Zmiana progu (modal ↔ sheet) przy otwartej nakładce: zamknij, by nie
  // zostawić niespójnego stanu między wariantami.
  sheetMQ.addEventListener("change", () => {
    if (!window.overlay?.isOpen()) return;
    window.overlay.close("work-modal");
    window.overlay.close("work-sheet");
  });
</script>

<style>
  .re {
    padding: 46px 0 0;
    background: #fff;
  }
  .re-in {
    width: 100%;
    max-width: var(--col);
    margin-inline: auto;
    padding-block: 0 20px;
    padding-inline: var(--pad);
  }
  .kick {
    font-family: var(--font-display), sans-serif;
    font-weight: 500;
    font-size: clamp(10px, 2.82vw, 12px);
    line-height: 1;
    letter-spacing: 0.2em;
    color: var(--accent-ink);
    margin-bottom: 14px;
  }
  h2 {
    font-family: var(--font-display), sans-serif;
    font-weight: 200;
    font-size: clamp(25px, 7.69vw, 33px);
    line-height: 1.2;
    text-wrap: pretty;
  }
  .dOnly {
    display: none;
  }
  .re-bar,
  .re-txts,
  .re-pill,
  .re-lupa {
    display: none;
  }
  .re-cards {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .rc {
    display: block;
    position: relative;
    height: clamp(420px, 133vw, 560px);
    overflow: hidden;
    background: #e5e1da;
    /* reset buttona (kafel-przycisk otwiera nakładkę) */
    width: 100%;
    padding: 0;
    border: none;
    cursor: pointer;
    text-align: left;
    font: inherit;
    color: inherit;
    -webkit-tap-highlight-color: transparent;
  }
  .rc:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }
  .rc img {
    position: absolute;
    left: 0;
    /* zapas na parallax (data-par) — jak w eksporcie */
    top: -76px;
    width: 100%;
    height: calc(100% + 152px);
    object-fit: cover;
  }
  .rc-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.18) 0%,
      rgba(0, 0, 0, 0) 42%,
      rgba(0, 0, 0, 0.55) 100%
    );
  }
  .rc-idx {
    position: absolute;
    top: 15px;
    right: 20px;
    font-family: var(--font-mono), monospace;
    font-weight: 500;
    font-size: 12px;
    line-height: 1;
    color: rgba(255, 255, 255, 0.85);
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.5);
  }
  .rc-txt {
    position: absolute;
    left: 20px;
    right: 20px;
    bottom: 22px;
    display: block;
  }
  .rc-tag {
    display: block;
    font-family: var(--font-display), sans-serif;
    font-weight: 500;
    font-size: clamp(9.5px, 2.7vw, 11px);
    line-height: 1;
    letter-spacing: 0.18em;
    color: rgba(255, 255, 255, 0.85);
    text-transform: uppercase;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.4);
  }
  .rc-title {
    display: block;
    margin-top: 8px;
    font-family: var(--font-display), sans-serif;
    font-weight: 300;
    font-size: clamp(18px, 5.38vw, 23px);
    line-height: 1.28;
    color: #fff;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.45);
    text-wrap: pretty;
  }
  .re-cta {
    width: 100%;
    max-width: var(--col);
    margin-inline: auto;
    padding-block: 4px 0;
    padding-inline: var(--pad);
    margin-top: 22px;
  }

  /* ════ DESKTOP ≥1024 (para: HOME_DESKTOP_MIN_PX) ════ */
  @media (min-width: 1024px) {
    .re {
      padding: clamp(60px, 6vw, 90px) 0 clamp(40px, 4vw, 60px);
      background: var(--bg-cream);
    }
    .mOnly {
      display: none;
    }
    .dOnly {
      display: block;
    }
    .kick {
      font-size: clamp(10.5px, 0.83vw, 12px);
      letter-spacing: 0.22em;
      margin-bottom: 18px;
    }
    h2 {
      font-size: clamp(38px, 3.89vw, 56px);
      line-height: 1.1;
    }
    .re-cards {
      gap: 26px;
    }
    .rc {
      border-radius: 8px;
    }

    /* ── scena przypięta (tylko html.js-motion — D-SG9) ── */
    :global(html.js-motion) .re {
      height: 300vh;
      position: relative;
      padding: 0;
    }
    :global(html.js-motion) .re-pin {
      position: sticky;
      top: 0;
      height: 100vh;
      overflow: hidden;
      background: var(--bg-cream);
      display: flex;
    }
    :global(html.js-motion) .re-in {
      width: 46%;
      flex: none;
      max-width: none;
      margin: 0;
      position: relative;
      padding-block: clamp(84px, 8.33vw, 120px) 0;
      padding-right: clamp(34px, 3.89vw, 56px);
      padding-left: var(--pad);
    }
    :global(html.js-motion) h2 {
      margin-bottom: clamp(40px, 5vw, 72px);
    }
    :global(html.js-motion) .re-txts {
      display: block;
      position: relative;
      height: clamp(240px, 20.1vw, 290px);
    }
    .re-tx {
      position: absolute;
      inset: 0;
      transition:
        opacity 0.45s ease,
        transform 0.55s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .re-meta {
      font-family: var(--font-display), sans-serif;
      font-weight: 500;
      font-size: 11px;
      line-height: 1.6;
      letter-spacing: 0.18em;
      color: var(--accent-ink);
    }
    .re-tx h3 {
      margin-top: 12px;
      font-family: var(--font-display), sans-serif;
      font-weight: 200;
      font-size: clamp(28px, 2.78vw, 40px);
      line-height: 1.15;
      text-wrap: pretty;
    }
    .re-tx p {
      margin-top: 18px;
      font-family: var(--font-display), sans-serif;
      font-weight: 200;
      font-size: clamp(15px, 1.15vw, 16.5px);
      line-height: 1.55;
      color: var(--muted);
      text-wrap: pretty;
      max-width: 46ch;
    }
    .re-tx a {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin-top: 18px;
      font-family: var(--font-body), sans-serif;
      font-weight: 500;
      font-size: 14px;
      line-height: 1;
      color: var(--ink);
      text-decoration: none;
      border-bottom: 1px solid rgba(26, 26, 26, 0.35);
      padding-bottom: 4px;
    }
    .re-tx a:hover {
      opacity: 0.6;
    }
    .re-tx svg {
      width: 15px;
      height: 15px;
    }
    :global(html.js-motion) .re-cards {
      position: relative;
      flex: 1;
      overflow: hidden;
      background: #e5e1da;
      gap: 0;
    }
    :global(html.js-motion) .rc {
      position: absolute;
      inset: 0;
      height: auto;
      border-radius: 0;
      transition: clip-path 1s cubic-bezier(0.76, 0, 0.24, 1);
    }
    :global(html.js-motion) .rc img {
      top: 0;
      height: 100%;
      transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    }
    :global(html.js-motion) .re-cards:hover .rc img {
      transform: scale(1.04);
    }
    :global(html.js-motion) .rc-scrim,
    :global(html.js-motion) .rc-idx,
    :global(html.js-motion) .rc-txt {
      display: none;
    }
    :global(html.js-motion) .re-cta {
      position: absolute;
      left: var(--pad);
      right: calc(54% + clamp(34px, 3.89vw, 56px));
      bottom: clamp(80px, 7.36vw, 106px);
      width: auto;
      max-width: none;
      margin: 0;
      padding: 0;
    }
    .re-cta :global(.btn-dark) {
      font-size: clamp(15px, 1.18vw, 17px);
      box-shadow: none;
    }
    :global(html.js-motion) .re-cta :global(.btn-dark) {
      padding: 20px 34px;
    }
    :global(html.js-motion) .re-bar {
      display: block;
      position: absolute;
      left: var(--pad);
      right: clamp(34px, 3.89vw, 56px);
      bottom: clamp(54px, 5vw, 72px);
      height: 2px;
      background: rgba(26, 26, 26, 0.12);
    }
    .re-bar b {
      display: block;
      height: 100%;
      background: var(--accent);
      transform: scaleX(0.33);
      transform-origin: left;
    }
    :global(html.js-motion) .re-pill {
      position: absolute;
      top: clamp(96px, 8.61vw, 124px);
      left: 28px;
      z-index: 3;
      display: flex;
      align-items: center;
      height: 44px;
      padding: 0 22px;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.6);
      background: rgba(255, 255, 255, 0.12);
      backdrop-filter: blur(3px);
      font-family: var(--font-display), sans-serif;
      font-weight: 500;
      font-size: 11px;
      line-height: 1;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: #fff;
      pointer-events: none;
    }
    :global(html.js-motion) .re-lupa {
      position: absolute;
      top: clamp(96px, 8.61vw, 124px);
      right: 28px;
      z-index: 3;
      width: 44px;
      height: 44px;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.6);
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(255, 255, 255, 0.12);
      backdrop-filter: blur(3px);
      transition:
        background 0.3s ease,
        border-color 0.3s ease;
      pointer-events: none;
    }
    :global(html.js-motion) .re-cards:hover .re-lupa {
      background: #fff;
      border-color: #fff;
    }
    :global(html.js-motion) .re-cards:hover .re-lupa svg circle,
    :global(html.js-motion) .re-cards:hover .re-lupa svg path {
      stroke: #1a1a1a;
    }
    .re-lupa svg {
      width: 19px;
      height: 19px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .re-tx,
    .rc,
    .rc img,
    .re-lupa {
      transition: none;
    }
  }
</style>
