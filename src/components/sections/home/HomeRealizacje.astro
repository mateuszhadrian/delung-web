---
// Zajawka realizacji (eksport: .re). Dane: top 3 wpisy kolekcji wg `order`
// (wzorzec szablonowego Work.astro). Kafle NIE nawigują — otwierają detal
// (Modal desktop / BottomSheet mobile) przez współdzielony open-detail
// (instrukcja Etapu 4 pkt 2; D-SG6). „Więcej" i CTA → /realizacje/
// (data-work-more — testy dojścia). Mobile: karty w kolumnie; desktop przy
// motion OK: scena przypięta 300vh — teksty przełączane postępem, stos
// zdjęć odsłaniany clip-path (home-scroll.ts); fallback: kolumna kart.
import { getCollection } from "astro:content";
import { WORK_INDEX_PATH } from "@/lib/routes";
import { imgAt } from "@/lib/img";
import { viewProject } from "@/components/sections/work/work-data";
import WorkDetail from "@/components/sections/work/WorkDetail.astro";
import WorkDetailOverlay from "@/components/sections/work/WorkDetailOverlay.astro";
import HomeCta from "./HomeCta.astro";

const entries = await getCollection("realizacje");
// Strona główna pokazuje TYLKO pierwsze 3 realizacje (pełna lista i filtry:
// /realizacje/).
const projects = entries
  .map((e) => e.data)
  .sort((a, b) => a.order - b.order)
  .map((p) => viewProject(p))
  .slice(0, 3);
---

<section class="re" data-home-re>
  <div class="re-pin">
    <div class="re-in">
      <p class="kick" data-rev>REALIZACJE</p>
      <h2 class="mOnly" data-rev>Zobacz nasze realizacje</h2>
      <h2 class="dOnly">Nasze realizacje</h2>
      {
        /* Rozpórka odstępu nagłówek → opis. NIE margines: na desktopie lewa
           kolumna jest kolumną flex i to właśnie ta rozpórka oddaje piksele
           jako pierwsza, gdy okno robi się niskie (D-Q5). Marginesy się nie
           kurczą, więc musi to być element. */
      }
      <i class="re-gap" aria-hidden="true"></i>
      <div class="re-txts" data-retxts>
        {
          projects.map((p, i) => (
            <div
              class="re-tx"
              data-retx
              data-tx-slug={p.slug}
              data-tx-name={p.title}
              style={i ? "opacity:0" : undefined}
            >
              <p class="re-meta">{p.categoryLabel.toUpperCase()}</p>
              <h3>{p.title}</h3>
              <p>{p.description}</p>
              <a href={WORK_INDEX_PATH} data-work-more>
                Więcej
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path
                    d="M5 12h14M13 6l6 6-6 6"
                    stroke="#1a1a1a"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>
            </div>
          ))
        }
      </div>
      <div class="re-bar" aria-hidden="true"><b data-rebar></b></div>
    </div>
    <div class="re-cards" data-recards>
      {
        projects.map((p, i) => (
          <button
            type="button"
            class="rc"
            data-work-slug={p.slug}
            data-work-name={p.title}
            aria-haspopup="dialog"
            data-rev="soft"
          >
            <img
              src={imgAt(p.cover.image, "full")}
              alt={p.title}
              loading="lazy"
              decoding="async"
              style={
                p.cover.position
                  ? `object-position:${p.cover.position}`
                  : undefined
              }
              data-par="0.11"
            />
            <span class="rc-scrim" aria-hidden="true" />
            <span class="rc-idx" aria-hidden="true">
              0{i + 1} / 0{projects.length}
            </span>
            <span class="rc-txt">
              <span class="rc-tag">{p.categoryLabel}</span>
              <span class="rc-title">{p.title}</span>
            </span>
          </button>
        ))
      }
      <span class="re-pill" data-repill aria-hidden="true">
        {projects[0]?.categoryLabel}
      </span>
      <span class="re-lupa" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none">
          <circle cx="11" cy="11" r="7" stroke="#fff" stroke-width="1.5"
          ></circle>
          <path
            d="M16.8 16.8L21 21M11 8.2v5.6M8.2 11h5.6"
            stroke="#fff"
            stroke-width="1.5"
            stroke-linecap="round"></path>
        </svg>
      </span>
    </div>
    <div class="re-cta" data-rev>
      <HomeCta href={WORK_INDEX_PATH} data-work-more>
        Przeglądaj nasze realizacje
      </HomeCta>
    </div>
  </div>

  {/* Treść szczegółów per realizacja — klonowana do nakładki po kliknięciu. */}
  {
    projects.map((project) => (
      <template data-work-detail={project.slug}>
        <WorkDetail project={project} />
      </template>
    ))
  }
  <WorkDetailOverlay />
</section>

<script>
  // Klik/tap w kafel → detal w #work-detail (wspólny helper open-detail,
  // część 4.4 — jeden overlay, wariant modal↔sheet w CSS przy 1024;
  // zamknięcie przy zmianie progu obsługuje open-detail). Na desktopowej
  // scenie przypiętej trafia zawsze bieżący, wierzchni kafel: clip-path
  // przycina też hit-testing pozostałych.
  import {
    openWorkDetail,
    setDetailContext,
  } from "@/components/sections/work/open-detail";

  const cards = document.querySelector<HTMLElement>("[data-recards]");
  // Kontekst projnav/licznika detalu = 3 kafle zajawki.
  setDetailContext(
    Array.from(
      cards?.querySelectorAll<HTMLElement>("[data-work-slug]") ?? [],
    ).map((card) => ({
      slug: card.dataset.workSlug ?? "",
      name: card.dataset.workName ?? "",
    })),
  );
  cards?.addEventListener("click", (e) => {
    const card = (e.target as HTMLElement).closest<HTMLElement>(
      "[data-work-slug]",
    );
    if (!card?.dataset.workSlug) return;
    openWorkDetail(card.dataset.workSlug, card.dataset.workName ?? "");
  });

  // „Więcej" w karcie opisu = to samo co klik w zdjęcie obok, czyli detal
  // TEJ realizacji (D-Q6). Dotąd link szedł na /realizacje/, więc dawał
  // efekt nieodróżnialny od CTA „Przeglądaj nasze realizacje" tuż niżej.
  // Karta opisu żyje TYLKO na desktopie w scenie przypiętej (poniżej progu
  // `.re-txts` jest `display: none`), więc nie ma tu bramki progowej.
  // `href` zostaje fallbackiem bez JS — wzorzec kafli kategorii (D-P2).
  document
    .querySelector<HTMLElement>("[data-retxts]")
    ?.addEventListener("click", (e) => {
      const link = (e.target as HTMLElement).closest<HTMLElement>(
        "a[data-work-more]",
      );
      if (!link) return;
      const tx = link.closest<HTMLElement>("[data-tx-slug]");
      if (!tx?.dataset.txSlug) return;
      e.preventDefault();
      openWorkDetail(tx.dataset.txSlug, tx.dataset.txName ?? "");
    });
</script>

<style>
  .re {
    padding: 46px 0 0;
    background: #fff;
  }
  .re-in {
    width: 100%;
    max-width: var(--col);
    margin-inline: auto;
    padding-block: 0 20px;
    padding-inline: var(--pad);
  }
  .kick {
    font-family: var(--font-display), sans-serif;
    font-weight: 500;
    font-size: clamp(10px, 2.82vw, 12px);
    line-height: 1;
    letter-spacing: 0.2em;
    color: var(--accent-ink);
    margin-bottom: 14px;
  }
  h2 {
    font-family: var(--font-display), sans-serif;
    font-weight: 200;
    font-size: clamp(25px, 7.69vw, 33px);
    line-height: 1.2;
    text-wrap: pretty;
  }
  .dOnly {
    display: none;
  }
  .re-bar,
  .re-gap,
  .re-txts,
  .re-pill,
  .re-lupa {
    display: none;
  }
  .re-cards {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .rc {
    display: block;
    position: relative;
    height: clamp(420px, 133vw, 560px);
    overflow: hidden;
    background: #e5e1da;
    /* reset buttona (kafel-przycisk otwiera nakładkę) */
    width: 100%;
    padding: 0;
    border: none;
    cursor: pointer;
    text-align: left;
    font: inherit;
    color: inherit;
    -webkit-tap-highlight-color: transparent;
  }
  .rc:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }
  .rc img {
    position: absolute;
    left: 0;
    /* zapas na parallax (data-par) — jak w eksporcie */
    top: -76px;
    width: 100%;
    height: calc(100% + 152px);
    object-fit: cover;
  }
  .rc-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.18) 0%,
      rgba(0, 0, 0, 0) 42%,
      rgba(0, 0, 0, 0.55) 100%
    );
  }
  .rc-idx {
    position: absolute;
    top: 15px;
    right: 20px;
    font-family: var(--font-mono), monospace;
    font-weight: 500;
    font-size: 12px;
    line-height: 1;
    color: rgba(255, 255, 255, 0.85);
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.5);
  }
  .rc-txt {
    position: absolute;
    left: 20px;
    right: 20px;
    bottom: 22px;
    display: block;
  }
  .rc-tag {
    display: block;
    font-family: var(--font-display), sans-serif;
    font-weight: 500;
    font-size: clamp(9.5px, 2.7vw, 11px);
    line-height: 1;
    letter-spacing: 0.18em;
    color: rgba(255, 255, 255, 0.85);
    text-transform: uppercase;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.4);
  }
  .rc-title {
    display: block;
    margin-top: 8px;
    font-family: var(--font-display), sans-serif;
    font-weight: 300;
    font-size: clamp(18px, 5.38vw, 23px);
    line-height: 1.28;
    color: #fff;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.45);
    text-wrap: pretty;
  }
  .re-cta {
    width: 100%;
    max-width: var(--col);
    margin-inline: auto;
    padding-block: 4px 0;
    padding-inline: var(--pad);
    margin-top: 22px;
  }

  /* ════ DESKTOP ≥1024 (para: HOME_DESKTOP_MIN_PX) ════ */
  @media (min-width: 1024px) {
    .re {
      padding: clamp(60px, 6vw, 90px) 0 clamp(40px, 4vw, 60px);
      background: var(--bg-cream);
    }
    .mOnly {
      display: none;
    }
    .dOnly {
      display: block;
    }
    .kick {
      font-size: clamp(10.5px, 0.83vw, 12px);
      letter-spacing: 0.22em;
      margin-bottom: 18px;
    }
    h2 {
      font-size: clamp(38px, 3.89vw, 56px);
      line-height: 1.1;
    }
    /* Nagłówek sekcji kurczy się DOPIERO po rozpórce i bloku opisu (D-Q5):
       przy 768 i 1080 px człon vh przegrywa w min() z wartością dotychczasową. */
    :global(html.js-motion) h2.dOnly {
      font-size: min(clamp(38px, 3.89vw, 56px), max(24px, calc(17vh - 77px)));
    }
    :global(html.js-motion) .kick {
      margin-bottom: min(18px, 2.6vh);
    }
    .re-cards {
      gap: 26px;
    }
    .rc {
      border-radius: 8px;
    }

    /* ── scena przypięta (tylko html.js-motion — D-SG9) ── */
    :global(html.js-motion) .re {
      height: 300vh;
      position: relative;
      padding: 0;
    }
    /* Siatka zamiast rzędu flex (D-Q5): CTA „Przeglądaj nasze realizacje"
       przestaje być pozycjonowane absolutnie i dostaje WŁASNY wiersz pod
       lewą kolumną. Dzięki temu wysokość dostępna dla nagłówka i opisu to
       `1fr`, czyli dokładnie tyle, ile zostaje po odjęciu pasa przycisku —
       treść nie ma jak pod niego wjechać. Przy pełnej wysokości okna
       geometria jest identyczna jak przed zmianą. */
    :global(html.js-motion) .re-pin {
      position: sticky;
      top: 0;
      height: 100vh;
      overflow: hidden;
      background: var(--bg-cream);
      display: grid;
      grid-template-columns: 46% 1fr;
      grid-template-rows: 1fr auto;
      /* Dolna granica odstępu „Więcej" → CTA (D-T4). Odstęp zabiera wysokość
         wierszowi tekstu, więc kolumna ma mniej miejsca i jej zawartość jedzie
         do góry — najpierw rozpórka, potem rampy skalowania. Przy wysokim
         oknie nic się nie rusza: pod tekstem zostaje tam kilkaset pikseli
         zapasu. Było: przy 1280×560 odstęp schodził do 0 px (styk). */
      row-gap: clamp(16px, 2.2vh, 28px);
    }
    :global(html.js-motion) .re-in {
      grid-column: 1;
      grid-row: 1;
      max-width: none;
      margin: 0;
      /* kolumna flex — rozpórka i blok opisu oddają piksele wg priorytetu
         (D-Q5); min-height:0 pozwala jej zejść poniżej rozmiaru treści */
      display: flex;
      flex-direction: column;
      min-height: 0;
      /* Kontener zapytań dla ramp skalowania treści karty (KOREKTA D-Q5 →
         D-T3). Dotąd siedział na `.re-txts`, ale tamto pudełko ma teraz
         wysokość WŁASNEJ TREŚCI, więc przestało maleć razem z oknem.
         Kolumna maleje: jej wysokość wyznacza wiersz `1fr` sceny minus
         `row-gap`. Współczynniki `cqh` niżej są przeliczone na tę wysokość
         Liczą się one od CONTENT-BOXA kolumny, czyli po odjęciu jej
         górnego paddingu — zmierzone 766 px przy oknie 1080 i 473 px przy 768.
         Próg zadziałania ramp (~392 px) jest dobrany tak, żeby budziły się
         DOPIERO wtedy, gdy rozpórka odda już swoje piksele — kolejność
         kurczenia z D-Q5 zostaje: najpierw odstęp nagłówek → opis, potem
         skalowanie treści karty. */
      container-type: size;
      /* rampa vh oddaje górne powietrze przy niskim oknie; przy 768 i 1080 px
         wygrywa wartość dotychczasowa (D-Q5) */
      padding-block: min(clamp(84px, 8.33vw, 120px), max(28px, 17vh)) 0;
      padding-right: clamp(34px, 3.89vw, 56px);
      padding-left: var(--pad);
    }
    :global(html.js-motion) .kick,
    :global(html.js-motion) h2 {
      flex: none;
    }
    /* Etap 1 kurczenia: rozpórka ma sto razy większy współczynnik kurczenia
       niż blok opisu, więc przy niskim oknie to ONA oddaje piksele — opis
       jedzie w stronę nagłówka, zamiast nachodzić na przycisk. Dojechawszy
       do podłogi 12 px, przestaje i pałeczkę przejmuje blok opisu. */
    :global(html.js-motion) .re-gap {
      display: block;
      /* Rozpórka oddaje piksele PIERWSZA — i robi to proaktywnie, rampą
         liczoną z wysokości kolumny (D-T3). Bez tego rampy skalowania treści
         (niżej) budziły się, gdy rozpórka miała jeszcze 60 px zapasu, czyli
         odwrotnie niż ustala D-Q5. Człon `calc` jest tak przesunięty, żeby
         przy 768 px wysokości okna dawał ponad 72 px (rozpórka śpi na obu
         rozmiarach referencyjnych), a podłogę 12 px osiągał przy kolumnie
         ~392 px — dopiero tam pałeczkę przejmuje skalowanie treści. */
      flex: 0 100 min(clamp(40px, 5vw, 72px), max(12px, calc(100cqh - 380px)));
      min-height: 12px;
    }
    /* Etap 2: blok opisu. Wysokość bierze się z NAJWYŻSZEJ z trzech kart
       (D-T3), a nie z szerokości okna. Poprzednia wartość
       `flex: 0 1 clamp(240px, 20.1vw, 290px)` była zgadywana z `vw`, a liczba
       linii, na które łamie się opis, nie zmienia się proporcjonalnie do
       szerokości — stąd ucinanie opisu przy 1024–1280 px NIEZALEŻNIE od
       wysokości okna (10 px przy 1152 px, czyli pół wiersza). Karty dzielą
       jedną komórkę siatki, więc dalej leżą jedna na drugiej, ale pudełko wie,
       ile miejsca naprawdę potrzebują. */
    :global(html.js-motion) .re-txts {
      display: grid;
      position: relative;
      flex: 0 1 auto;
      min-height: 112px;
    }
    /* Karta = kolumna flex wypełniająca pudełko bloku (D-Q5). To jest TWARDA
       gwarancja braku kolizji z przyciskiem: treść nie ma jak wyjść poza
       własny boks, bo opis (jedyny element, który wolno ścisnąć) oddaje
       miejsce i przycina się na dole. Kicker, tytuł i „Więcej" są nietykalne
       — przy najniższych oknach użytkownik traci ogon opisu, a nie
       nagłówek albo wyjście do realizacji. Opisy idą z CMS-a i bywają
       różnej długości, więc gwarancja musi być strukturalna, nie liczbowa. */
    .re-tx:first-child {
      pointer-events: auto;
    }
    .re-tx {
      /* wszystkie trzy karty w JEDNEJ komórce siatki — leżą na sobie jak
         dotąd (przełącza je opacity), ale współtworzą wysokość pudełka (D-T3) */
      grid-area: 1 / 1;
      display: flex;
      flex-direction: column;
      min-height: 0;
      /* Trzy karty leżą JEDNA NA DRUGIEJ. Bez tego ostatnia w DOM-ie łapie
         kliknięcia także przy `opacity: 0` i zasłania link „Więcej"
         widocznej karty — stąd zgłoszony brak kursora i brak reakcji
         (D-Q6). Aktywną kartę odblokowuje home-scroll.ts; pierwsza jest
         aktywna w SSR, więc dostaje to samo regułą CSS. */
      pointer-events: none;
      transition:
        opacity 0.45s ease,
        transform 0.55s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .re-meta,
    .re-tx h3,
    .re-tx a {
      flex: none;
    }
    .re-meta {
      font-family: var(--font-display), sans-serif;
      font-weight: 500;
      font-size: 11px;
      /* Cała treść karty skaluje się WYSOKOŚCIĄ swojego kontenera (D-Q5):
         dzieci są ułożone jedno na drugim (position:absolute), więc pudełko
         ma sztywną wysokość i treść musi się w niej zmieścić sama. Każdy
         współczynnik cqh jest dobrany tak, żeby przy pełnej wysokości okna
         przegrywał w min() z wartością dotychczasową — czyli mechanizm śpi,
         dopóki nie zrobi się naprawdę ciasno. */
      font-size: max(9px, min(11px, 2.85cqh));
      line-height: 1.6;
      letter-spacing: 0.18em;
      color: var(--accent-ink);
    }
    .re-tx h3 {
      margin-top: min(12px, 3.1cqh);
      font-family: var(--font-display), sans-serif;
      font-weight: 200;
      font-size: clamp(28px, 2.78vw, 40px);
      /* Człon cqh wygrywa DOPIERO, gdy blok opisu zacznie się kurczyć —
         przy pełnej wysokości okna jest większy od dotychczasowej wartości,
         więc min() wybiera stan sprzed rundy (zero zmian w baseline'ach).
         Bez wsparcia dla kontenerów deklaracja jest nieprawidłowa i zostaje
         sam clamp() z linijki wyżej — czytelna degradacja. */
      font-size: max(19px, min(clamp(28px, 2.78vw, 40px), 9.7cqh));
      line-height: 1.15;
      text-wrap: pretty;
    }
    .re-tx p {
      margin-top: min(18px, 4.65cqh);
      font-family: var(--font-display), sans-serif;
      font-weight: 200;
      font-size: clamp(15px, 1.15vw, 16.5px);
      /* jak przy h3, z twardą podłogą czytelności */
      font-size: max(12px, min(clamp(15px, 1.15vw, 16.5px), 4.05cqh));
      line-height: 1.55;
      color: var(--muted);
      text-wrap: pretty;
      /* jedyny element oddający miejsce; min-height:0 pozwala mu zejść
         poniżej rozmiaru treści, overflow ucina ogon zamiast wylewać go
         na przycisk */
      flex: 0 1 auto;
      min-height: 0;
      overflow: hidden;
      max-width: 46ch;
    }
    .re-tx a {
      display: inline-flex;
      /* karta jest kolumną flex (D-Q5), więc bez tego link rozciągnąłby się
         na całą szerokość kolumny razem z podkreśleniem */
      align-self: flex-start;
      align-items: center;
      gap: 8px;
      margin-top: min(18px, 4.65cqh);
      font-family: var(--font-body), sans-serif;
      font-weight: 500;
      font-size: max(11px, min(14px, 3.6cqh));
      line-height: 1;
      color: var(--ink);
      text-decoration: none;
      border-bottom: 1px solid rgba(26, 26, 26, 0.35);
      padding-bottom: 4px;
    }
    .re-tx a:hover {
      opacity: 0.6;
    }
    .re-tx svg {
      width: 15px;
      height: 15px;
    }
    :global(html.js-motion) .re-cards {
      position: relative;
      grid-column: 2;
      grid-row: 1 / span 2;
      overflow: hidden;
      background: #e5e1da;
      gap: 0;
    }
    :global(html.js-motion) .rc {
      position: absolute;
      inset: 0;
      height: auto;
      border-radius: 0;
      transition: clip-path 1s cubic-bezier(0.76, 0, 0.24, 1);
    }
    :global(html.js-motion) .rc img {
      top: 0;
      height: 100%;
      transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
