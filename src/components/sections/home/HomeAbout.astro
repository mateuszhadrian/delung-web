---
// Zajawka „O nas" (eksport: .abt). Mobile: zdjęcie Adama + kicker/h2/lead
// + cytat serif + CTA „Więcej o nas". Desktop: wyłącznie cytat (Cormorant
// italic) rozjaśniany słowo po słowie postępem scrolla (home-scroll dzieli
// tekst na spany — stąd :global w stylach spanów) + CTA.
import { ABOUT_PATH } from "@/lib/routes";
import HomeCta from "./HomeCta.astro";
import adam from "@/assets/home/adam.webp";
---

<section class="abt" data-home-abt>
  <div class="abt-in">
    <div class="abt-photo" data-rev="soft">
      <img
        src={adam.src}
        width={adam.width}
        height={adam.height}
        alt="Adam Delung przy pracy w warsztacie"
        loading="lazy"
        decoding="async"
        data-par="0.09"
      />
    </div>
    <div class="abt-txt">
      <p class="kick" data-rev>O NAS</p>
      <h2 data-rev>U nas słowo „niemożliwe” nie istnieje.</h2>
      <div class="rule" data-rev></div>
      <p class="abt-lead" data-rev>
        Działamy na własnych, bezkompromisowych zasadach. Najbardziej irytuje
        nas, gdy w branży idzie się na łatwiznę. Wybieramy trudniejsze drogi, bo
        tylko one dają spektakularne efekty.
      </p>
      <p class="abt-quote" data-rev>
        „Ja ogólnie nie chodzę do pracy. Ja to po prostu lubię robić.”
        <em>— Adam, właściciel</em>
      </p>
      <p class="abt-quoteD" data-abtquote>
        „U nas słowo «niemożliwe» nie istnieje. Albo robimy coś od serca i z
        maksymalną precyzją, albo nie robimy tego wcale.” — Adam, właściciel
      </p>
      <div class="abt-cta" data-rev>
        <HomeCta href={ABOUT_PATH} variant="out">Więcej o nas</HomeCta>
      </div>
    </div>
  </div>
</section>

<style>
  .abt {
    padding: 48px 0 0;
    background: #fff;
  }
  .abt-in {
    width: 100%;
    max-width: var(--col);
    margin-inline: auto;
    padding-inline: var(--pad);
  }
  .abt-photo {
    position: relative;
    height: clamp(300px, 102.6vw, 420px);
    border-radius: 8px;
    overflow: hidden;
    background: #e5e1da;
  }
  .abt-photo img {
    position: absolute;
    left: 0;
    /* zapas na parallax (data-par) — jak w eksporcie */
    top: -60px;
    width: 100%;
    height: calc(100% + 120px);
    object-fit: cover;
    object-position: 46% 16%;
  }
  .abt-txt {
    padding-top: 24px;
  }
  .kick {
    font-family: var(--font-display), sans-serif;
    font-weight: 500;
    font-size: clamp(10px, 2.82vw, 12px);
    line-height: 1;
    letter-spacing: 0.2em;
    color: var(--accent-ink);
    margin-bottom: 14px;
  }
  h2 {
    font-family: var(--font-display), sans-serif;
    font-weight: 200;
    font-size: clamp(25px, 7.69vw, 33px);
    line-height: 1.2;
    text-wrap: pretty;
  }
  .rule {
    width: 44px;
    height: 1px;
    background: rgba(26, 26, 26, 0.3);
    margin: 16px 0;
  }
  .abt-lead {
    font-family: var(--font-display), sans-serif;
    font-weight: 200;
    font-size: clamp(13.5px, 3.97vw, 17px);
    line-height: 1.48;
    color: var(--muted);
    text-wrap: pretty;
  }
  .abt-quote {
    margin-top: 18px;
    font-family: var(--font-serif), serif;
    font-style: italic;
    font-weight: 500;
    font-size: clamp(18px, 5.38vw, 23px);
    line-height: 1.38;
    text-wrap: pretty;
  }
  .abt-quote em {
    font-family: var(--font-display), sans-serif;
    font-style: normal;
    font-weight: 200;
    font-size: clamp(12px, 3.33vw, 13.5px);
    /* eksport .55 — podbite do --faint (drobny druk, ratchet axe) */
    color: var(--faint);
  }
  .abt-quoteD {
    display: none;
  }
  .abt-cta {
    margin-top: 22px;
  }

  /* ════ DESKTOP ≥1024 (para: HOME_DESKTOP_MIN_PX) ════ */
  @media (min-width: 1024px) {
    .abt {
      padding: clamp(100px, 10.4vw, 150px) 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 52px;
    }
    .abt-in {
      max-width: var(--col);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 52px;
    }
    .abt-photo,
    .kick,
    h2,
    .rule,
    .abt-lead,
    .abt-quote {
      display: none;
    }
    .abt-txt {
      padding: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .abt-quoteD {
      display: block;
      font-family: var(--font-serif), serif;
      font-style: italic;
      font-weight: 500;
      font-size: clamp(30px, 3.19vw, 46px);
      line-height: 1.4;
      text-align: center;
      max-width: 900px;
      text-wrap: pretty;
    }
    /* spany słów tworzy home-scroll (poza scope komponentu) */
    .abt-quoteD :global(span) {
      transition: opacity 0.35s linear;
    }
    .abt-cta {
      margin-top: 52px;
      align-self: center;
    }
    .abt-cta :global(.btn-out) {
      padding: 16px 32px;
      font-size: clamp(15px, 1.11vw, 16px);
    }
    .abt-cta :global(.btn-out svg) {
      width: 18px;
      height: 18px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .abt-quoteD :global(span) {
      transition: none;
    }
  }
</style>
