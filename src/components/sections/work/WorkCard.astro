---
import { imgAt } from "@/lib/img";
import type { ViewProject } from "./work-data";

interface Props {
  project: ViewProject;
  index: number;
  cta: string;
}
const { project, index, cta } = Astro.props;
const flip = index % 2 === 1;
---

<button
  type="button"
  class="rz-card"
  data-flip={flip}
  data-work-slug={project.slug}
  data-work-name={project.title}
  aria-label={`${project.title} — ${cta}`}
>
  <div class="rz-card__media">
    <img
      class="rz-card__img"
      src={imgAt(project.cover.image, "full")}
      alt=""
      loading="lazy"
      decoding="async"
      style={project.cover.position
        ? `object-position: ${project.cover.position}`
        : undefined}
    />
  </div>

  <div class="rz-card__meta">
    <div class="rz-card__tagline">
      <span class="rz-card__category">{project.categoryLabel}</span>
      <span class="rz-card__dot" aria-hidden="true">·</span>
      <span class="rz-card__year">{project.year}</span>
    </div>

    <div>
      <h3 class="rz-card__name">{project.title}</h3>
      <p class="rz-card__blurb">{project.description}</p>
    </div>

    <span class="rz-card__cta">
      <span>{cta}</span>
      <svg
        class="rz-card__arrow"
        width="15"
        height="15"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M5 12h13M13 6l6 6-6 6"></path>
      </svg>
    </span>
  </div>
</button>

<style>
  .rz-card {
    appearance: none;
    -webkit-appearance: none;
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    outline: none;
    position: relative;
    width: 100%;
    display: grid;
    align-items: center;
    gap: clamp(28px, 5vw, 90px);
  }
  .rz-card > * {
    position: relative;
    z-index: 1;
  }

  .rz-card::before {
    content: "";
    position: absolute;
    inset: -22px -26px;
    border-radius: 4px;
    border: 1px solid rgba(245, 240, 236, 0.28);
    background: rgba(245, 240, 236, 0.03);
    opacity: 0;
    pointer-events: none;
    z-index: 0;
    transition: opacity 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .rz-card:focus-visible::before {
    opacity: 1;
  }

  @media (hover: hover) {
    .rz-card:hover::before {
      opacity: 1;
    }
    .rz-card:hover .rz-card__img {
      transform: scale(1.045);
    }
    .rz-card:hover .rz-card__cta {
      border-bottom-color: rgba(245, 240, 236, 0.5);
    }
    .rz-card:hover .rz-card__arrow {
      transform: translateX(4px);
    }
  }

  /* Przejściowy kafel zdjęciowy (docelowy wygląd kafli = Etap 4). */
  .rz-card__media {
    overflow: hidden;
    border-radius: 4px;
  }
  .rz-card__img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .rz-card__meta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }
  .rz-card__tagline {
    display: flex;
    align-items: baseline;
    gap: 10px;
    flex-wrap: wrap;
  }
  .rz-card__category {
    font-family: var(--font-mono), monospace;
    font-size: 10.5px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--accent-gold);
  }
  .rz-card__dot {
    font-family: var(--font-mono), monospace;
    font-size: 10.5px;
    color: var(--faint);
  }
  .rz-card__year {
    font-family: var(--font-mono), monospace;
    font-size: 10.5px;
    letter-spacing: 0.16em;
    color: var(--faint);
  }
  .rz-card__name {
    margin: 0;
    font-family: var(--font-display), sans-serif;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.02;
    font-size: 34px;
    color: var(--ink);
  }
  .rz-card__blurb {
    margin: 8px 0 0;
    font-family: var(--font-body), sans-serif;
    font-weight: 500;
    font-size: 16px;
    line-height: 1.45;
    color: var(--muted);
    max-width: 440px;
    text-wrap: pretty;
  }
  .rz-card__cta {
    margin-top: 6px;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-body), sans-serif;
    font-weight: 700;
    font-size: 14px;
    color: var(--ink);
    border-bottom: 1px solid var(--line);
    padding-bottom: 7px;
    transition: border-color 0.25s;
  }
  .rz-card__arrow {
    display: block;
    color: var(--accent-gold);
    transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  @media (min-width: 761px) {
    .rz-card {
      grid-template-columns: 1.15fr 1fr;
    }
    .rz-card[data-flip="true"] {
      grid-template-columns: 1fr 1.15fr;
    }
    .rz-card[data-flip="true"] .rz-card__media {
      order: 2;
    }
    .rz-card[data-flip="true"] .rz-card__meta {
      order: 1;
    }
  }

  @media (max-width: 760px) {
    .rz-card {
      grid-template-columns: 1fr;
      justify-items: center;
      gap: 22px;
    }
    .rz-card__media {
      width: 100%;
      display: flex;
      justify-content: center;
    }
    .rz-card__meta {
      align-items: center;
      text-align: center;
    }
    .rz-card__tagline {
      justify-content: center;
    }
    .rz-card__name {
      font-size: 26px;
    }
    .rz-card__blurb {
      font-size: 14px;
    }
    .rz-card::before {
      inset: -18px -20px;
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rz-card::before,
    .rz-card__cta,
    .rz-card__arrow {
      transition: none;
    }
    .rz-card__img {
      transition: none;
    }
    .rz-card:hover .rz-card__img {
      transform: none;
    }
  }
</style>
