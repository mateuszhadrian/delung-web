---
// Treść szczegółów realizacji — wspólna dla modala (desktop) i bottom sheeta
// (mobile). Renderowana wewnątrz <template> per projekt w Work.astro, a po
// kliknięciu kafelka klonowana do właściwej nakładki. Układ (2 kolumny vs stos)
// wynika z media-query 760px — tej samej, która decyduje modal vs sheet.
// Przejściowa wersja pod nowy schemat (galeria + specs); docelowy detal wg
// designu realizacje.html wchodzi w Etapie 4.4 (tam też pełny wzorzec wideo:
// odtwarzanie na tap z badge play + duration).
import { imgAt } from "@/lib/img";
import type { ViewProject } from "./work-data";

interface Props {
  project: ViewProject;
  galleryLabel: string;
  specsLabel: string;
}
const { project, galleryLabel, specsLabel } = Astro.props;
const p = project;
---

<article class="wdx">
  <header class="wdx__header">
    <div class="wdx__tagline">
      <span class="wdx__category">{p.categoryLabel}</span>
      <span class="wdx__dot" aria-hidden="true">·</span>
      <span class="wdx__year">{p.year}</span>
    </div>
    <h2 class="wdx__title">{p.title}</h2>
    <p class="wdx__intro">{p.description}</p>
  </header>

  <div class="wdx__gallery">
    <p class="wdx__gallery-head">{galleryLabel}</p>
    {
      p.gallery.map((item, i) => (
        <figure class="wdx__shot">
          {item.video ? (
            /* eslint-disable-next-line astro/jsx-a11y/media-has-caption --
               klipy realizacji to nieme b-rolle mebli (bez ścieżki dialogowej) */
            <video
              class="wdx__media"
              src={item.video}
              poster={imgAt(item.image, "full")}
              preload="none"
              controls
              playsinline
              style={
                item.position ? `object-position: ${item.position}` : undefined
              }
            />
          ) : (
            <img
              class="wdx__media"
              src={imgAt(item.image, "full")}
              alt={`${p.title} — zdjęcie ${i + 1}`}
              loading="lazy"
              decoding="async"
              style={
                item.position ? `object-position: ${item.position}` : undefined
              }
            />
          )}
          {item.video && item.duration && (
            <figcaption class="wdx__duration">{item.duration}</figcaption>
          )}
        </figure>
      ))
    }
  </div>

  <div class="wdx__body">
    <section class="wdx__block">
      <p class="wdx__block-head">{specsLabel}</p>
      <dl class="wdx__specs">
        {
          p.specs.map((s) => (
            <div class="wdx__spec">
              <dt class="wdx__spec-label">{s.label}</dt>
              <dd class="wdx__spec-value">{s.value}</dd>
            </div>
          ))
        }
      </dl>
    </section>
  </div>
</article>

<style>
  /* ── Wspólne (stos — domyślny, mobile/sheet) ── */
  .wdx {
    display: flex;
    flex-direction: column;
    gap: 30px;
    color: var(--ink);
  }

  .wdx__tagline {
    display: flex;
    align-items: baseline;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }
  .wdx__category {
    font-family: var(--font-mono), monospace;
    font-size: 10.5px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--accent-gold);
  }
  .wdx__dot {
    font-family: var(--font-mono), monospace;
    font-size: 10.5px;
    color: var(--faint);
  }
  .wdx__year {
    font-family: var(--font-mono), monospace;
    font-size: 10.5px;
    letter-spacing: 0.16em;
    color: var(--faint);
  }
  .wdx__title {
    margin: 0;
    font-family: var(--font-display), sans-serif;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
    font-size: clamp(30px, 7vw, 48px);
    color: var(--ink);
  }
  .wdx__intro {
    margin: 16px 0 0;
    font-family: var(--font-body), sans-serif;
    font-weight: 500;
    font-size: 16px;
    line-height: 1.55;
    color: var(--muted);
    text-wrap: pretty;
  }

  /* ── Galeria ── */
  .wdx__gallery {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .wdx__gallery-head {
    margin: 0;
    font-family: var(--font-mono), monospace;
    font-size: 10.5px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--faint);
  }
  .wdx__shot {
    position: relative;
    margin: 0;
  }
  .wdx__media {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 4px;
    background: rgba(245, 240, 236, 0.04);
  }
  .wdx__duration {
    position: absolute;
    right: 10px;
    bottom: 10px;
    padding: 3px 8px;
    border-radius: 3px;
    background: rgba(0, 0, 0, 0.55);
    font-family: var(--font-mono), monospace;
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--ink);
    pointer-events: none;
  }

  /* ── Body: parametry ── */
  .wdx__body {
    display: flex;
    flex-direction: column;
    gap: 30px;
  }
  .wdx__block-head {
    margin: 0 0 16px;
    font-family: var(--font-mono), monospace;
    font-size: 10.5px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--faint);
  }
  .wdx__specs {
    margin: 0;
    display: flex;
    flex-direction: column;
  }
  .wdx__spec {
    display: grid;
    grid-template-columns: minmax(120px, 0.55fr) 1fr;
    gap: 16px;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
  }
  .wdx__spec:first-child {
    border-top: 1px solid var(--line);
  }
  .wdx__spec-label {
    font-family: var(--font-mono), monospace;
    font-size: 10.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent-gold);
    align-self: baseline;
    padding-top: 2px;
  }
  .wdx__spec-value {
    margin: 0;
    font-family: var(--font-body), sans-serif;
    font-weight: 500;
    font-size: 14.5px;
    line-height: 1.45;
    color: var(--muted);
  }

  /* ════ Desktop / modal: dwie kolumny ════ */
  @media (min-width: 761px) {
    .wdx {
      display: grid;
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto 1fr;
      grid-template-areas:
        "gallery header"
        "gallery body";
      gap: 0;
    }
    .wdx__header {
      grid-area: header;
      padding: clamp(28px, 3.5vw, 48px) clamp(28px, 3.5vw, 48px) 0;
    }
    .wdx__gallery {
      grid-area: gallery;
      gap: clamp(20px, 2.5vw, 32px);
      padding: clamp(28px, 3.5vw, 48px);
      border-right: 1px solid var(--line);
      background: rgba(255, 255, 255, 0.012);
    }
    .wdx__gallery-head {
      display: none;
    }
    .wdx__body {
      grid-area: body;
      padding: clamp(24px, 3vw, 34px) clamp(28px, 3.5vw, 48px)
        clamp(28px, 3.5vw, 48px);
    }
  }
</style>
