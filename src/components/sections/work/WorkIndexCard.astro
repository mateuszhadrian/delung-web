---
// Kafel siatki /realizacje/ (część 4.4) — port `tile` z designu
// docs/design/realizacje.html. Karta jest <button>, bo klik otwiera
// detal w #work-detail (WorkDetailOverlay), nie nawigację.
// `data-cat` konsumuje filtrowanie (skrypt WorkIndexPage), kontrakty
// data-work-slug/-name — open-detail i testy. Zdjęcie kafla: cover przez
// imgAt() (media w R2); mobile parallax ±70 px robi work-motion.ts na
// [data-tilepar] (stan bez JS = statyczny offset z CSS, jak w eksporcie).
import { imgAt } from "@/lib/img";
import type { ViewProject } from "./work-data";

interface Props {
  project: ViewProject;
}
const { project } = Astro.props;
const p = project;
---

<button
  type="button"
  class="tile"
  data-work-slug={p.slug}
  data-work-name={p.title}
  data-cat={p.category}
  aria-haspopup="dialog"
  aria-label={`${p.title} — zobacz szczegóły realizacji`}
>
  <span class="tile-fig">
    <img
      src={imgAt(p.cover.image, "full")}
      alt=""
      loading="lazy"
      decoding="async"
      draggable="false"
      data-tilepar
      style={p.cover.position
        ? `object-position: ${p.cover.position}`
        : undefined}
    />
    <span class="tile-scrim" aria-hidden="true"></span>
    <span class="tile-tag">{p.categoryLabel}</span>
    <span class="tile-lupa" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none">
        <circle cx="11" cy="11" r="7" stroke="#fff" stroke-width="1.5"></circle>
        <path
          d="M16.8 16.8L21 21M11 8.2v5.6M8.2 11h5.6"
          stroke="#fff"
          stroke-width="1.5"
          stroke-linecap="round"></path>
      </svg>
    </span>
  </span>
  <span class="tile-body">
    <span class="tile-title">{p.title}</span>
    <span class="tile-foot">
      <span class="tile-cta">
        Zobacz szczegóły<span class="tile-ctaLong"> realizacji</span>
      </span>
      <span class="tile-circle" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none">
          <circle cx="11" cy="11" r="7" stroke="#1a1a1a" stroke-width="1.5"
          ></circle>
          <path
            d="M16.8 16.8L21 21M11 8.2v5.6M8.2 11h5.6"
            stroke="#1a1a1a"
            stroke-width="1.5"
            stroke-linecap="round"></path>
        </svg>
      </span>
    </span>
  </span>
</button>

<style>
  /* ── Mobile (<1024): kafel z ramką, parallax kadru ── */
  .tile {
    /* reset przycisku */
    appearance: none;
    margin: 0;
    padding: 0;
    background: none;
    color: var(--ink);
    font: inherit;
    text-align: left;
    cursor: pointer;

    display: block;
    width: 100%;
    border: 1px solid rgba(26, 26, 26, 0.28);
  }
  .tile:hover {
    border-color: rgba(26, 26, 26, 0.5);
  }
  .tile:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 4px;
  }
  .tile[hidden] {
    display: none;
  }

  .tile-fig {
    display: block;
    position: relative;
    aspect-ratio: 1.034;
    overflow: hidden;
    background: #e5e1da;
  }
  .tile-fig img {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    width: 100%;
    height: calc(100% + 70px);
    object-fit: cover;
    transform: translate3d(0, -35px, 0);
  }
  .tile-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.22) 0%,
      rgba(0, 0, 0, 0) 34%
    );
  }
  .tile-tag {
    position: absolute;
    top: 16px;
    left: 20px;
    font-family: var(--font-display), sans-serif;
    font-weight: 500;
    font-size: clamp(10px, 2.82vw, 11px);
    line-height: 1;
    letter-spacing: 0.2em;
    color: #fff;
    text-transform: uppercase;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.5);
  }
  .tile-lupa {
    display: none;
  }

  .tile-body {
    display: block;
    padding: 16px 18px 18px;
  }
  .tile-title {
    display: block;
    font-family: var(--font-display), sans-serif;
    font-weight: 300;
    font-size: clamp(17px, 5.13vw, 21px);
    line-height: 1.3;
    text-wrap: pretty;
  }
  .tile-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid rgba(26, 26, 26, 0.14);
  }
  .tile-cta {
    font-family: var(--font-display), sans-serif;
    font-weight: 500;
    font-size: clamp(10px, 2.82vw, 11px);
    line-height: 1.5;
    letter-spacing: 0.14em;
    color: var(--faint);
    text-transform: uppercase;
  }
  .tile-circle {
    width: 38px;
    height: 38px;
    flex: none;
    border: 1px solid rgba(26, 26, 26, 0.4);
    border-radius: 999px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .tile-circle svg {
    width: 17px;
    height: 17px;
  }

  /* ── Desktop (≥1024): bez ramki, hover zoom + lupka ── */
  @media (min-width: 1024px) {
    .tile {
      border: none;
    }
    .tile-fig {
      aspect-ratio: 1.384;
    }
    .tile-fig img {
      bottom: 0;
      height: 100%;
      transform: none;
      transition: transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .tile:hover .tile-fig img {
      transform: scale(1.06);
    }
    .tile-scrim {
      background: linear-gradient(
        180deg,
        rgba(0, 0, 0, 0.2) 0%,
        rgba(0, 0, 0, 0) 32%
      );
    }
    .tile-tag {
      top: 18px;
      font-size: 10.5px;
    }
    .tile-lupa {
      display: flex;
      position: absolute;
      right: 18px;
      bottom: 18px;
      width: 44px;
      height: 44px;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.7);
      background: rgba(255, 255, 255, 0.16);
      align-items: center;
      justify-content: center;
      transition:
        background 0.4s ease,
        border-color 0.4s ease;
    }
    .tile:hover .tile-lupa {
      background: #fff;
      border-color: #fff;
    }
    .tile:hover .tile-lupa svg circle,
    .tile:hover .tile-lupa svg path {
      stroke: #1a1a1a;
    }
    .tile-lupa svg {
      width: 18px;
      height: 18px;
    }
    .tile-body {
      padding: 16px 0 0;
    }
    .tile-title {
      font-weight: 200;
      font-size: clamp(18px, 1.53vw, 22px);
      line-height: 1.28;
      transition: opacity 0.3s ease;
    }
    .tile:hover .tile-title {
      opacity: 0.72;
    }
    .tile-foot {
      margin-top: 12px;
      padding-top: 0;
      border-top: none;
    }
    .tile-cta {
      font-family: var(--font-body), sans-serif;
      font-size: 13px;
      letter-spacing: 0;
      text-transform: none;
      color: var(--faint);
    }
    .tile-ctaLong {
      display: none;
    }
    .tile-circle {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tile-fig img,
    .tile-lupa,
    .tile-title {
      transition: none;
    }
    .tile:hover .tile-fig img {
      transform: none;
    }
  }
</style>
