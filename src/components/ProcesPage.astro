---
// Widok /proces-wspolpracy/ (część 4.5) — port docs/design/proces.html;
// decyzje: docs/analiza-proces-onas-polityka.md. Navbar `over` w tonie
// ciemnym (D-P2 — blok .hdr.dark z eksportu). Cały ruch (reveale,
// parallax, swap kroków, liczniki) za bramką motion (proces-motion.ts) —
// stany startowe uzbraja html.js-motion inline przed paintem, bez JS /
// przy reduce strona jest w pełni statyczna.
import BaseLayout from "@/layouts/BaseLayout.astro";
import Navbar from "@/components/navbar/Navbar.astro";
import Footer from "@/components/Footer.astro";
import ProcesHero from "@/components/sections/proces/ProcesHero.astro";
import ProcesSteps from "@/components/sections/proces/ProcesSteps.astro";
import ProcesEfekt from "@/components/sections/proces/ProcesEfekt.astro";
import ProcesCta from "@/components/sections/proces/ProcesCta.astro";

const DESCRIPTION =
  "Jak wygląda współpraca z Delung Meble — od pomiaru i projektu po montaż. " +
  "Cztery kroki do mebli na wymiar.";
---

<BaseLayout title="Proces współpracy — Delung Meble" description={DESCRIPTION}>
  <script is:inline>
    // PRZED paintem: motion OK → html.js-motion (uzbraja stany startowe
    // revealów — reszta w proces-motion.ts, ładowanym niżej).
    if (window.matchMedia("(prefers-reduced-motion: no-preference)").matches) {
      document.documentElement.classList.add("js-motion");
    }
  </script>

  <Navbar variant="over" tone="dark" />

  <main>
    <ProcesHero />
    <ProcesSteps />
    <ProcesEfekt />
    <ProcesCta />
  </main>

  <Footer />
</BaseLayout>

<style is:global>
  /* Odsłanianie treści przy przewijaniu — tylko widok mobilny; stan
     startowy WYŁĄCZNIE pod html.js-motion (bez JS / przy reduce treść
     od razu widoczna — reguła sections.md; wzorzec OfertaPage 4.3). */
  @media (max-width: 1023px) {
    html.js-motion [data-rev] {
      opacity: 0;
      transform: translateY(22px);
      transition:
        opacity 0.7s ease,
        transform 0.8s cubic-bezier(0.22, 0.61, 0.36, 1);
    }
    html.js-motion [data-rev].rv-in {
      opacity: 1;
      transform: none;
    }
    html.js-motion [data-rev="soft"],
    html.js-motion [data-rev="soft"].rv-in {
      transform: none;
    }
  }
</style>

<script>
  // Ruch — dynamicznie, tylko przy motion OK (wzorzec D-SG9).
  if (matchMedia("(prefers-reduced-motion: no-preference)").matches) {
    import("@/components/sections/proces/proces-motion");
  }
</script>
