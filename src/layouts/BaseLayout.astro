---
// Fonty delung (self-hosted przez fontsource — lekcja FOUC/LCP; Google
// Fonts i GSAP-z-CDN z eksportów designów NIE wchodzą do produkcji):
// — Archivo Variable: display (rola Helvetiki z designów — decyzja 0.4),
// — Manrope Variable: body,
// — Cormorant Garamond: akcenty serif (normal + italic, wagi 400/500).
import "@fontsource-variable/archivo/index.css";
import "@fontsource-variable/manrope/index.css";
import "@fontsource/cormorant-garamond/400.css";
import "@fontsource/cormorant-garamond/500.css";
import "@fontsource/cormorant-garamond/400-italic.css";
import "@fontsource/cormorant-garamond/500-italic.css";

import "@/styles/global.css";

import LoadingOverlay from "@/components/ui/LoadingOverlay.astro";

// Preload krojów above-the-fold — skraca okno font-display:swap (mniejszy
// „przeskok" z fontu systemowego przy nawigacji). Import ?url zamiast
// hardkodu: hash pliku woff2 zmienia się co build. Strona jest PL-only,
// więc kryte są oba subsety (latin + latin-ext — polskie diakrytyki).
// Cormorant Garamond celowo BEZ preloadu: akcenty serif nie są krytyczne
// above-the-fold (dogrywa się swapem); zestaw preloadów zweryfikowany
// pomiarem LHCI (Etap 3, budżety zacieśniane trzykrotnie od tego czasu).
import archivoWoff2 from "@fontsource-variable/archivo/files/archivo-latin-wght-normal.woff2?url";
import archivoExtWoff2 from "@fontsource-variable/archivo/files/archivo-latin-ext-wght-normal.woff2?url";
import manropeWoff2 from "@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url";
import manropeExtWoff2 from "@fontsource-variable/manrope/files/manrope-latin-ext-wght-normal.woff2?url";

interface Props {
  title?: string;
  lang?: string;
  /** Opcjonalny meta description (podstrony; strona główna go nie ustawia). */
  description?: string;
  /** Nadpisanie canonicala (np. /kategorie/ → canonical na /oferta/ —
   *  mobile-only widok z desktopowym redirectem; analiza §7). */
  canonicalPath?: string;
}
const {
  title = "Delung Meble — meble na wymiar",
  lang = "pl",
  description,
  canonicalPath,
} = Astro.props;

// Adresy absolutne dla podglądów linków (iMessage/Messenger/X wymagają pełnego URL).
// W dev bazą jest bieżący host (np. adres w sieci lokalnej), by podgląd linka
// działał przed deployem; w buildzie produkcyjnym — domena z astro.config.
// og-image.png = pełne logo Delung na tle „cream", kadr 1200×630 (Etap 6,
// D-E2: napis niesie NAZWĘ firmy, sam znaczek nikomu jej nie powie; 1,91:1
// to proporcje, których nie przycina Facebook/X/LinkedIn). Generowany przez
// `node scripts/make-icons.mjs` razem z kompletem ikon — nie podmieniaj
// ręcznie. Bez og:image komunikatory same wybierają przypadkowy duży
// obrazek ze strony.
const urlBase = import.meta.env.DEV ? Astro.url : Astro.site;
const canonicalUrl = new URL(canonicalPath ?? Astro.url.pathname, urlBase);
const ogImageUrl = new URL("/og-image.png", urlBase);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {
      /* Slot head — dla skryptów, które MUSZĄ odpalić przed paintem
         (np. desktopowy redirect /kategorie/ → /oferta/). */
    }
    <slot name="head" />
    <meta name="generator" content={Astro.generator} />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={archivoWoff2}
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={archivoExtWoff2}
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={manropeWoff2}
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={manropeExtWoff2}
      crossorigin
    />
    <script is:inline>
      // Mikro-fade przy nawigacji WEWNĘTRZNEJ (docs/visual-corrections-part1.md
      // pkt 8): pierwsza wizyta w karcie (brak flagi sessionStorage) renderuje
      // się bez żadnej bramki — zero wpływu na LCP (LHCI i Playwright wchodzą
      // na zimno). Przy kolejnych nawigacjach treść wjeżdża krótkim fade'em
      // zdejmowanym przez document.fonts.ready LUB twardy timeout 300 ms —
      // strona nigdy nie zostaje ukryta (błąd JS/brak JS = brak klasy
      // nav-fade, czyli domyślnie widoczna).
      (() => {
        try {
          const KEY = "hm:visited";
          const revisit = sessionStorage.getItem(KEY) === "1";
          sessionStorage.setItem(KEY, "1");
          if (!revisit) return;
          const root = document.documentElement;
          root.classList.add("nav-fade");
          const reveal = () => root.classList.add("fonts-in");
          setTimeout(reveal, 300);
          if (document.fonts && document.fonts.ready)
            document.fonts.ready.then(reveal, reveal);
        } catch {
          /* sessionStorage niedostępny (tryb prywatny) — bez fade */
        }
      })();
    </script>
    <style is:global>
      /* Bramka mikro-fade — patrz inline skrypt wyżej. Stan bazowy (bez
         .nav-fade) jest w pełni widoczny. */
      html.nav-fade body {
        opacity: 0;
      }
      html.nav-fade.fonts-in body {
        opacity: 1;
        transition: opacity 0.18s ease;
      }
      @media (prefers-reduced-motion: reduce) {
        html.nav-fade.fonts-in body {
          transition: none;
        }
      }
    </style>
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="delung.pl" />
    <meta property="og:title" content={title} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Delung Meble — producent mebli na wymiar"
    />
    <meta property="og:locale" content="pl_PL" />
    {
      /* summary_large_image, nie summary: przy kadrze 1,91:1 „summary"
         zredukowałby podgląd do miniaturki-kwadracika (D-E2). */
    }
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonicalUrl} />
  </head>
  <body>
    <LoadingOverlay />
    <slot />
    <script>
      import { initBackLinks } from "@/scripts/back-link";

      // Linki „wstecz" podstron (a[data-back]) → history.back() zamiast nowej
      // nawigacji — przywraca miejsce scrolla poprzedniej strony (moduł).
      initBackLinks();
    </script>
  </body>
</html>
